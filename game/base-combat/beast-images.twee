					<<if $NPCList[_na].type is "hawk">>
					<</if>>
					<<if $NPCList[_na].type is "cow" or $NPCList[_na].type is "bull">>
						<!-- Cow sprites go here -->
					<</if>>
					<<if $NPCList[_na].type is "fox">>
						<img @class="'layer-beastback anim-doggy-4f-'+_animspeed" src="img/sex/missionary/beast/fox/foxbase.png">
