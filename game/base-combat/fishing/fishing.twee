:: Widgets fishing [widget]
	<<set $rod_strength to 10>> /*buy new fishingrods with strength */
	<<set $fish_position to { x: random(0, 10), y: random(0, 4) }>>
	<<set $line_strength to $rod_strength>>
	<<set $fish_tiredness to 0>> 
<<widget "fishing_game">>
	<div style="text-align: center;">
		<style>
			.fishing-grid {
				border: 5px solid #000;
				display: inline-block;
				padding: 10px; 
			}
			.fishing-grid td {
				padding: 10px; 
				font-size: 24px; 
			}
			</style>

	<table class="fishing-grid">
		<<for _row to 0; _row lt 5; _row++>>
			<tr>
			<<for _col to 0; _col lt 11; _col++>>
				<td>
					<<if $fish_position.x is _col and $fish_position.y is _row>>
						🐟
					<<else>>
						♒︎
					<</if>>
				</td>
			<</for>>
			</tr>
		<</for>>
		</table>
	</div>
<</widget>>

<<widget "fishing_init">>
	<<set $position to "fishing">>
	<<set $leftarm to "fishing">>
	<<set $rightarm to "fishing">>
<</widget>>