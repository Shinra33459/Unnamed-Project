/* start making actual fish movement and passages to leave the fishing game, maybe something like <<whitneey exit>> can work otherwise try settinfg up $fishlocation instead 
of $fishlake/$fishocean and then you can set
exact places plus links*/
.
/*when you done and can release make sure to remove the memo marks on stuff called "fishing release" */

/*
				`<<set $science += 1000>>`,
				`<<set $maths += 1000>>`,
				`<<set $english += 1000>>`,
				`<<set $history += 1000>>`,
				`<<set $sciencetrait to 4>>`,
				`<<set $mathstrait to 4>>`,
				`<<set $englishtrait to 4>>`,
				`<<set $historytrait to 4>>`,
				`<<set $skulduggery += 1000>>`,
				`<<set $danceskill += 1000>>`,
				`<<set $swimmingskill += 1000>>`,
				`<<set $bottomskill += 1000>>`,
				`<<set $seductionskill += 1000>>`,
				`<<set $handskill += 1000>>`,
				`<<set $feetskill += 1000>>`,
				`<<set $chestskill += 1000>>`,
				`<<set $thighskill += 1000>>`,
				`<<set $oralskill += 1000>>`,
				`<<set $analskill += 1000>>`,
				`<<set $vaginalskill += 1000>>`,
				`<<set $penileskill += 1000>>`,
				`<<set $promiscuity += 100>>`,
				`<<set $exhibitionism += 100>>`,
				`<<set $deviancy += 100>>`,
				`<<set $awareness to 1000>>`,
				`<<set $willpower to 1000>>`,
				`<<set $physique to 12000>>`,
				`<<set $orgasmtrait to 1>>`,
				`<<set $ejactrait to 1>>`,
				`<<set $molesttrait to 1>>`,
				`<<set $rapetrait to 1>>`,
				`<<set $bestialitytrait to 1>>`,
				`<<set $tentacletrait to 1>>`,
				`<<set $choketrait to 1>>`, */
:: Widgets fishing [widget]
<<widget "fishing_init">> 
    <<if $options.numberify_enabled == 1>>
        <<set $numberssetting to 1>>
        <<set $options.numberify_enabled to 0>>
    <<else>>
        <<set $numberssetting to 0>>
    <</if>>
	<<fish_reset>>
	<<set $player_strength to (Math.round(($feetskill + $athletics + $fishing)/150))>>
	<<set $fish_tiredness to 0>>
	<<set $fish_bait to 10>> 
	<<set $total_fish to 0>>
	<<set $fish_round to 0>>
	<<set $reel_chance to 0>>
    <<set $f_caught to 0>>
    <<set $fish_strength to (Math.round(($fish_base_strength + random(1, 5) - $fish_tiredness)))>>
<</widget>>


<<widget "check_fish_position">>
    <<set $zone to "none">>
    <<if $fish_position.x is 1 or $fish_position.x is 11 or $fish_position.y is 1 or $fish_position.y is 5>>
        <<if $fish_position.x is 0>>
            <<set $zone to "left">>
        <<elseif $fish_position.x gte 1 and $fish_position.x lte 8>>
            <<set $zone to "middle">>
        <<elseif $fish_position.x gte 9 and $fish_position.x lte 11>>
            <<set $zone to "right">>
        <</if>>
    <</if>>
<</widget>>

<<widget "fish_movement">>
    <<if $reel_chance is 1>>
		<<if random(1, 2) == 1>>
			<<if random(1, 2) == 1>>
				<<if $fish_position.y == 3>>
					<<if random(1, 2) == 1>>
						<<set $fish_position.y += 1>>
					<<else>>
						<<set $fish_position.y -= 1>>
					<</if>>
				<<elseif $fish_position.y == 2>>
					<<set $fish_position.y -= 1>>
				<<elseif $fish_position.y == 4>>
					<<set $fish_position.y += 1>>
				<</if>>
			<<else>>
				<<if $fish_position.y <= 6 and $fish_position.y >= 3>>
					<<set $fish_position.y -= 2>>
				<<elseif $fish_position.y <= 4 and $fish_position.y >= 1>>
					<<set $fish_position.y += 2>>
				<</if>>
			<</if>>
            <<elseif $fish_tiredness <= 10000>>
                <<if $fish_position.x < 11>>
                    <<set $fish_position.x += 1>>
                <</if>>
            <</if>>
    <</if>>
<</widget>>


<<widget "fish_caught">>
    <<set $f_caught to 1>>
	<<set $total_fish += 1>>
<</widget>>

<<widget "fish_linebreak">>
	<<if $zone is "left">> /* rod and line dmg */
			<<set $rod_strength -= random(1, 3)>>
			<<set $line_strength -= random(1, 3)>>
		<<elseif $zone is "middle">> /*rod dmg */
			<<set $rod_strength -= random(1, 3)>>
		<<elseif $zone is "right">> /*line dmg */
			<<set $line_strength -= random(1, 3)>>
		<<else>> /*fish isnt in danger zone*/
		<</if>>
        <div style="text-align: center;">
            <style>
                .line-container {
                    border: 10px solid #000;
                    padding: 10px;
                }
            </style>
            <div class="line-container">
                <div>
                    <<if $f_caught is 1>>

                        You just caught a <span class= "green"><<print $fish_names>></span>, Do you want to keep fishiing?
                        <br><br><br>
                        <<link[[Yes|Fishing System]]>><<fish_reset>><</link>><br>
                        <<link[[No|Bedroom]]>><<fish_leave>><</link>><br>
                        <<set $f_caught to 0>>

				    <<elseif $line_strength lte 0>>
   				    	Your fishing line/rod broke, do you want to keep fishing? 
                        <br><br><br>
                        <<link[[Yes|Fishing System]]>><<fish_reset>><</link>><br>
                        <<link[[No|Bedroom]]>><<fish_leave>><</link>><br>
					<<else>> 
                        <<print $fish_position.x>><<print $fish_position.y>>
						fish name and type <<print $fish_names>> <<print $fish_type>>, rod strength <<print $rod_strength>>, line strength <<print $line_strength>>, fish tiredness <<print $fish_tiredness>>, reel chance <<print $reel_chance>>, stability <<print $fish_stability>>, player strength <<print $player_strength>>, fish strength <<print $fish_strength>>
					<</if>>
				</div>
            </div>
        </div>
<</widget>>
	
<<widget "fish_reset">>
    <<set $rng to random(1, 100)>>
    <<if $fish_location is "ocean">>
        <<if $rng lte 25>>
            <<set $fish_type to "small">>
        <<elseif $rng lte 60>>
            <<set $fish_type to "medium">>
        <<elseif $rng lte 85>>
            <<set $fish_type to "large">>
        <<else>>
            <<set $fish_type to "huge">>
        <</if>>
        <<set $rng1 to random(1, 100)>>
        <<switch $fish_type>>
            <<case "small">>
                <<if $rng1 lte 35>>
                    <<set $fish_names to "Sardine">>
                <<elseif $rng1 lte 60>>
                    <<set $fish_names to "Goldfish">>
                <<elseif $rng1 lte 75>>
                    <<set $fish_names to "Guppy">>
                <<elseif $rng1 lte 85>>
                    <<set $fish_names to "Betta">>
                <<elseif $rng1 lte 92>>
                    <<set $fish_names to "Anchovy">>
                <<elseif $rng1 lte 98>>
                    <<set $fish_names to "Tetra">>
                <<else>>
                    <<set $fish_names to "Molly">>
                <</if>>
            <<case "medium">>         
                <<if $rng1 lte 15>>
                    <<set $fish_names to "Blue tang">>
                <<elseif $rng1 lte 35>>
                    <<set $fish_names to "Bass">>
                <<elseif $rng1 lte 55>>
                    <<set $fish_names to "Koi">>
                <<elseif $rng1 lte 70>>
                    <<set $fish_names to "Angelfish">>
                <<elseif $rng1 lte 80>>
                    <<set $fish_names to "Rainbowfish">>
                <<elseif $rng1 lte 90>>
                    <<set $fish_names to "Plecostomus">>
                <<else>>
                    <<set $fish_names to "Clownfish">>
                <</if>>
            <<case "large">>
                <<if $rng1 lte 5>>
                    <<set $fish_names to "Swordfish">>
                <<elseif $rng1 lte 20>>
                    <<set $fish_names to "Mahi-Mahi">>
                <<elseif $rng1 lte 40>>
                    <<set $fish_names to "Tuna">>
                <<elseif $rng1 lte 60>>
                    <<set $fish_names to "Trout">>
                <<elseif $rng1 lte 75>>
                    <<set $fish_names to "Barramundi">>
                <<else>>
                    <<set $fish_names to "Marlin">>
                <</if>>
            <<case "huge">>
                <<if $rng1 lte 2>>
                    <<set $fish_names to "Sunfish">>
                <<elseif $rng1 lte 10>>
                    <<set $fish_names to "Squid">>
                <<elseif $rng1 lte 25>>
                    <<set $fish_names to "Shark">>
                <<elseif $rng1 lte 40>>
                    <<set $fish_names to "Dolphin">>
                <<elseif $rng1 lte 60>>
                    <<set $fish_names to "Giant Trevally">>
                <<else>>
                    <<set $fish_names to "Blue Marlin">>
                <</if>>
        <</switch>>
    <<elseif $fish_location is "lake">>
        <<if $rng lte 45>>
            <<set $fish_type to "small">>
        <<elseif $rng lte 75>>
            <<set $fish_type to "medium">>
        <<elseif $rng lte 90>>
            <<set $fish_type to "large">>
        <<else>>
            <<set $fish_type to "huge">>
        <</if>>
        <<set $rng1 to random(1, 100)>>
        <<switch $fish_type>>
            <<case "small">>
                <<if $rng1 lte 30>>
                    <<set $fish_names to "Bluegill">>
                <<elseif $rng1 lte 55>>
                    <<set $fish_names to "Perch">>
                <<elseif $rng1 lte 70>>
                    <<set $fish_names to "Crappie">>
                <<elseif $rng1 lte 80>>
                    <<set $fish_names to "Minnow">>
                <<elseif $rng1 lte 90>>
                    <<set $fish_names to "Carp">>
                <<else>>
                    <<set $fish_names to "Pike">>
                <</if>>
            <<case "medium">>         
                <<if $rng1 lte 30>>
                    <<set $fish_names to "Walleye">>
                <<elseif $rng1 lte 50>>
                    <<set $fish_names to "Trout">>
                <<elseif $rng1 lte 65>>
                    <<set $fish_names to "Perch">>
                <<elseif $rng1 lte 80>>
                    <<set $fish_names to "Catfish">>
                <<else>>
                    <<set $fish_names to "Medium Bass">>
                <</if>>
            <<case "large">>
                <<if $rng1 lte 5>>
                    <<set $fish_names to "Sturgeon">>
                <<elseif $rng1 lte 20>>
                    <<set $fish_names to "Bluefish">>
                <<elseif $rng1 lte 40>>
                    <<set $fish_names to "Muskie">>
                <<elseif $rng1 lte 60>>
                    <<set $fish_names to "Large Bass">>
                <<elseif $rng1 lte 75>>
                    <<set $fish_names to "Taimen">>
                <<else>>
                    <<set $fish_names to "Bowfin">>
                <</if>>
            <<case "huge">>
                <<if $rng1 lte 2>>
                    <<set $fish_names to "Alligator">>
                <<elseif $rng1 lte 10>>
                    <<set $fish_names to "Piranha">>
                <<elseif $rng1 lte 25>>
                    <<set $fish_names to "Muskellunge">>
                <<elseif $rng1 lte 40>>
                    <<set $fish_names to "Pike">>
                <<elseif $rng1 lte 60>>
                    <<set $fish_names to "Sturgeon">>
                <<else>>
                    <<set $fish_names to "Bream">>
                <</if>>
        <</switch>>
    <</if>>
	<<set $fish_position to { x: random(4, 4), y: random(2, 5) }>>
	<<set $fish_tiredness = 0>> 
	<<set $fish_bait -= 1>> 
    <<switch $fishing_line>>
        <<case "monofilament">>
            <<set $line_strength to 25>>
        <<case "fluorocarbon">>
            <<if $fish_location is "ocean">>
                <<set $line_strength to 80>>
            <<else>>
                <<set $line_strength to 30>>
            <</if>>
        <<case "braided line">>
            <<if $fish_location is "lake">>
                <<set $line_strength to 80>>
            <<else>>
                <<set $line_strength to 30>>
            <</if>>
        <<case "copolymer">>
            <<set $line_strength to 65>>
    <</switch>>
    <<switch $fishingrod>>
        <<case "masterwork">>
            <<set $rod_strength to 50>>
        <<case "high-quality">>
            <<set $rod_strength to 40>>
        <<case "decent">>
            <<set $rod_strength to 30>>
        <<case "mediocre">>
            <<set $rod_strength to 20>>
        <<case "abysmal">>
            <<set $rod_strength to 10>>
    <</switch>>
    <<switch $fish_type>>
        <<case "small">>
            <<set $fish_base_strength to (random(5,9))>>
        <<case "medium">>
            <<set $fish_base_strength to (random(6,12))>>
        <<case "large">>
            <<set $fish_base_strength to (random(10,15))>>
        <<case "huge">>
            <<set $fish_base_strength to (random(13,20))>>
    <</switch>>
<</widget>>


<<widget "fish_reel">>
    <<set $fish_strength to (Math.round(( $fish_base_strength + random(1, 5) - $fish_tiredness)))>>
    <<if $fish_strength > $player_strength>>
        <<set $reel_chance to 1>>
    <<elseif $fish_strength <= $player_strength>>
        <<set $reel_chance to 2>>
    <</if>>

    <<if $reel_chance is 2>>
        <<if $phase is 1>>  up
            <<set $fish_position.x -= (random(1, 1))>>
        <<elseif $phase is 2>> left
            <<set $fish_position.y -= (random(1, 1))>>
        <<elseif $phase is 3>> down   /*if you dont reel the fish will exhaust itself*/
            <<set $fish_position.x += (random(1, 1))>>
        <<else>> right
            <<set $fish_position.y += (random(1, 1))>>
        <</if>>
    <</if>>
    <<if (($fish_position.x == 0) && ($fish_position.y == 3))>>   
        <<fish_caught>>
        <</if>>
	/* The more tired a fish is, the more chance to reel it in. 
	   If the fish is not tired, damage the line a lot.
 
	   If you reel, check if the fish is tired.
	   Then check if you are stronger than the fish (considering a combination of fish size, physique, athletics, technique, feet, and arms).
	   The chance rating is based on the quality of your rod and line.
	*/
	/*when you done and can release make sure to remove the memo marks on stuff called "fishing release" */
<</widget>>

<<widget "fish_exhaust">>
    <<if $reel_chance is 1>>
        <<if $phase is 1>> up
            <<set $fish_tiredness -= (random(2,4))>>
        <<elseif $phase is 2>> left
            <<if $fish_position.y <= 3>>
              <<set $fish_tiredness -= (random(2,5))>>
            <<else>>
                <<set $fish_tiredness -= (random(2,5))>>
            <</if>>
        <<elseif $phase is 3>> down
            <<set $fish_tiredness += (random(3,5))>>
        <<else>> right
            <<set $fish_tiredness -= (random(2,5))>>
        <</if>>
    <<else>>
        <<if $phase is 1>>
        <<elseif $phase is 2>>
        <<elseif $phase is 3>>
            <<set $fish_tiredness += (random(2,5))>>
        <<else>>
        <</if>>
    <</if>>
<</widget>>

<<widget "fish_leave">>
    <<print "You caught " + $total_fish + " fish!">>
    <<run delete $total_fish>>
    <<run delete $fish_linebreak>>
    <<run delete $fish_movement>>
    <<run delete $fish_position>>
    <<run delete $fish_tiredness>>
    <<run delete $fish_names>>
    <<run delete $rod_strength>>
    <<run delete $line_strength>>
    <<run delete $fish_location>>
    <<run delete $reel_chance>>
    <<if $numberssetting is 1>>
        <<set $options.numberify_enabled to 1>>
    <</if>>
    <<run delete $numberssetting>>
<</widget>>


<<widget "fishing_display">>
<div style="text-align: center;">
    <style>
        .fishing-container {
            display: table;
            margin: 0 auto;
        }
        .fishing-row {
            display: table-row;
        }
        .fishing-cell {
            display: table-cell;
            vertical-align: middle;
            padding: 10px;
        }
        .fishing-grid {
            border: 5px solid #000;
            display: inline-block;
            padding: 10px;
        }
        .fishing-grid td {
            padding: 10px;
            font-size: 35px;
        }
		.fishing-colome {
			border: 10px solid #000;
			vertical-align: middle;
			font-size: 37px;
			line-height: 1;
			color: #2e1f41;
		}
    </style>

    <div class="fishing-container">
        <div class="fishing-row">
            <div class="fishing-cell">
                <div> you have <<if $fish_bait gte 0>>a total of <<print $fish_bait>> pieces of bait <<else>>no more bait<</if>></div>
            </div>
            <div class="fishing-cell">
                <table class="fishing-grid">
                    <<for _row to 1; _row lt 6; _row++>>
                        <tr>
                            <<for _col to 0; _col lt 12; _col++>>
                                <td>
									<<if _col is 0 and _row is 3>>
										█
                                    <<elseif $fish_position.x is _col and $fish_position.y is _row>>
                                        🐟
                                    <<else>>
                                        ♒︎
                                    <</if>>
                                </td>
                            <</for>>
                        </tr>
                    <</for>>
                </table>
            </div>
			<br>
            <div class="fishing-colome">
                <div> 	
						<<if $fish_tiredness gte 100>>
							fish tiredness<br>█<br>█<br>█<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 90>>
							fish tiredness<br>█<br>█<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 80>>
							fish tiredness<br>█<br>█<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 70>>
							fish tiredness<br>█<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 60>>
							fish tiredness<br>█<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 50>>
							fish tiredness<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 40>>
							fish tiredness<br>█<br>█<br>█
						<<elseif $fish_tiredness gte 30>>
							fish tiredness<br>█<br>█
						<<elseif $fish_tiredness gte 20>>
							fish tiredness<br>█<br>█
						<<elseif $fish_tiredness gte 10>>
							fish tiredness<br>█
						<<elseif $fish_tiredness gte 0>>
							fish tiredness<br>█
						<<else>>
						<</if>>
				</div>
            </div>
        </div>
    </div>
</div>
<</widget>>