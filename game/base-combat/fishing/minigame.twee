:: Fishing System
<<fish_exhaust>>
<<fish_movement>>
<<fishing_display>>
<<fish_linebreak>>

<<if $rod_strength lte 0 or $line_strength lte 0>>
	<<link[[Next|Fishing End]]>><</link>>
<<else>>
	<<check_fish_position>>
	<br> 
	<<print $fish_round>>
	<br>
	<<set $fish_round += 1>> 
	<br><br>
	<<print $fish_tiredness>>
	<br>
	<div style="text-align: center;">
		<style>
			.fishing-button {
				border: 10px solid #000;
				display: inline-block;
				padding: 10px;
				background-color: #241E6B;
				border-radius: 15px;
			}
			.fishing-buttons {
				font-size: 25px; 
				display: inline-block;
				padding: 10px;
			}
			.fishing-link {
				display: inline-block;
				padding: 10px;
				background-color: #241E6B;
				font-size: 25px; 
			}
			.fishing-link:hover {
				border-radius: 5px;
				background-color: #130F42;
			}
		</style>
		<table class="fishing-button" style="margin: 0 auto;">
			<tr>
				<td class="fishing-buttons"></td>
				<td class="fishing-link">
					<<link [[⬆️|Fishing System]]>><<set $phase to 1>><<fish_reel>><span class="fishing-link"></span><</link>>
				</td>
				<td class="fishing-buttons"></td>
			</tr>
			<tr>
				<td class="fishing-link">
					<<link [[⬅️|Fishing System]]>><<set $phase to 2>><<fish_reel>><span class="fishing-link"></span><</link>>
				</td>
				<td class="fishing-link">
					<<link [[🟦|Fishing System]]>><<set $phase to 3>><<fish_reel>><span class="fishing-link"></span><</link>>
				</td>
				<td class="fishing-link">
					<<link [[➡️|Fishing System]]>><<set $phase to 4>><<fish_reel>><span class="fishing-link"></span><</link>>
				</td>
			</tr>
			<tr>
				<td class="fishing-buttons"></td>
				<td class="fishing-link">
					<<link [[🛑|Bedroom]]>><span class="fishing-link"><<fish_leave>></span><</link>>
				</td>
				<td class="fishing-buttons"></td>
			</tr>
		</table>
	</div>
<</if>>
