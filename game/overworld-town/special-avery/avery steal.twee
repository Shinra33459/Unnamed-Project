:: Mansion Steal Dumb
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<set $skulduggerydifficulty to 800>>
<<if ($phase is "bottle_of_milk" and ($cat gte 6 or ($transformationParts.cat.tail isnot "hidden" and $transformationParts.cat.tail isnot "disabled"))) or ($phase is "wild_honeycomb" and ($bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled"))) or ($phase is "chicken_egg" and ($fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled"))) or ($phase is "pork" and ($cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")))>>
	<<set $skulduggerydifficulty to 500>>
<</if>>
<<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
	<<switch $phase>>
	<<case "banana" "wild_carrot" "chilli_pepper">>
		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"I wanted to use <<recipe_name $phase "article">>," you say the first thing that comes to mind. "F-for pleasure"
		<<elseif $speech_attitude is "bratty">>
			"I wanted to fuck <<recipe_name $phase "article">>," you say the first thing that comes to mind.
		<<else>>
			"I wanted to use <<recipe_name $phase "article">> as a dildo," you say the first thing that comes to mind.
		<</if>>
        <br><br>
		<<if C.npc.Avery.penis isnot "none">>
			"I'm sure I can do it better.
		<<else>>
			"Just don't put it in any food later.
		<</if>>
		<<if $avery_mansion.jobs.includes("kitchen")>> and clean this mess up.<</if>>"
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<case "bottle_of_milk">>
		<<if $cat gte 6>>
			You meow and drink the milk without saying a word. Avery raises <<his>> eyebrow, but doesn't say anything till you finish.
            <br><br>
			"Right, you are my kitten after all.<<if $avery_mansion.jobs.includes("kitchen")>>Just clean the mess after yourself.<</if>>"
		<<else>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I was planning to make <<recipe_name $phase2 "article">>," you explain.
			<<elseif $speech_attitude is "bratty">>
				"I wanted to make <<recipe_name $phase2 "article">>," you say nonchalantly.
			<<else>>
				"I wanted to make <<recipe_name $phase2 "article">>," you say smoothly.
			<</if>>
			<<if ($foodstuff[$phase2].recipe)>>
				If only you knew how to make it.
				<br><br>
				"<<recipe_name $phase2 "cap">>?" Avery raises <<his>> eyebrow. "I didn't know you could cook <<recipe_name $phase2 "article">>. Aren't you full of surprises? <<if $avery_mansion.jobs.includes("kitchen")>>Still - you must clean up.<<else>>Still - you should be more careful with your cooking experiments.<</if>>
			<<else>>
				<br><br>
				"Makes sense," <<he>> answers, <<his>> curiosity satisfied. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>
			<</if>>
		<</if>>
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<case "apple" "orange" "lemon" "pear" "strawberry" "peach" "plum" "blackberry" "tomato">>
		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"I wanted to snack on <<recipe_name $phase2 "article">>, but I accidentally broke the jar. I'm sorry."
		<<elseif $speech_attitude is "bratty">>
			"I was in mood for something fresh, but the jar got in my way and broke."
		<<else>>
			"I was in mood for something fresh, but I accidentally broke the jar."
		<</if>>
        <br><br>
		"Right, of course. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<case "wild_honeycomb">>
		<<if $bear gte 6>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I wanted to eat the honeycomb. With larves and wax," you must have gotten a bit too much into the detail because Avery stopped you.
			<<elseif $speech_attitude is "bratty">>
				"I'm a bear<<girl>>, eating honeycombs is pretty normal for me. Wax and larves and such," you must have gotten a bit too much into the detail because Avery stopped you.
			<<else>>
				"I really like eating honeycombs. Wax and all. And the larves," you must have gotten a bit too much into the detail because Avery stopped you.
			<</if>>
            <br><br>
            "That's enough. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>"
		<<else>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I wanted to make some candles from the wax," you explain. "But I made a mess. I'm sorry."
			<<elseif $speech_attitude is "bratty">>
				"It was for candlemaking," you start explaining. "Honey-scented candles."
			<<else>>
				"I wanted to make some candles," you explain. "From the wax."
			<</if>>
            <br><br>
			"Candles?" Avery raises <<his>> eyebrow, slightly surprised. "I didn't know you were interested in such things. Well, just make sure for it to not go to waste. They are hard to come by.<<if $avery_mansion.jobs.includes("kitchen")>> And also - clean that mess before somebody gets injured.<</if>>"
		<</if>>
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<case "garlic_bulb">>
		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"I think I catched a flu," you start. "I didn't want to give you a cold, so I wanted to take something healthy."
		<<elseif $speech_attitude is "bratty">>
			"I catched something," you start. "Thought some garlic would help."
		<<else>>
			"My throat is sore," you start. "I think I catched something and I thought I'd kill it before it develops. Wouldn't want to get you sick."
		<</if>>
        <br><br>
		"I'm sure it will help.<<if $avery_mansion.jobs.includes("kitchen")>> Just clean the glass first.<</if>>"
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<case "chicken_egg">>
		<<if $fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled")>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I'm sorry, I just wanted to bury the egg," you start your explanation. "I'm a fox<<girl>>, and I really felt like I needed it."
			<<elseif $speech_attitude is "bratty">>
				"I'm a fox<<girl>>. I felt the need to bury an egg, so I took the egg."
			<<else>>
				"I wanted to bury the egg," you start your explanation. "I'm a fox<<girl>>, it's my natural need."
			<</if>>
			<br><br>
            Avery chuckled. "You wanted to bury it, obviously. I suppose you do look the part. 
			<<if $avery_mansion.jobs.includes("kitchen")>>
				Well, you still have to clean it up, my <<= $player.gender_appearance is "m" ? "kit" : "vixen">>." <<He>> sighs. "Take that egg, just don't break anything more.
			<<else>>
				Just leave that for the maids to clean." <<He>>  stops and then sighs. "You can take that egg, just don't break anything more.
			<</if>>"
			<br><br>
            <<He>> leaves the kitchen.
            <br><br>
			<<tending_pick $phase 1 1>>
		<<else>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I was planning to make <<recipe_name $phase2 "article">>," you explain.
			<<elseif $speech_attitude is "bratty">>
				"I wanted to make <<recipe_name $phase2 "article">>," you say nonchalantly.
			<<else>>
				"I wanted to make <<recipe_name $phase2 "article">>," you say smoothly.
			<</if>>
			<<if ($foodstuff[$phase2].recipe)>>
                If only you knew how to make it.
                <br><br>
				"<<recipe_name $phase2 "cap">>?" Avery raises <<his>> eyebrow. "I didn't know you could cook <<recipe_name $phase2 "article">>. Aren't you full of surprises? <<if $avery_mansion.jobs.includes("kitchen")>>Still - you must clean up.<<else>>Still - you should be more careful with your cooking experiments.<</if>>
			<<else>>
				<br><br>
				"Makes sense," <<he>> answers, <<his>> curiosity satisfied. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>
			<</if>>
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
		<</if>>
	<<case "beef" "pork">>
		<<if ($cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")) and $phase is "pork">>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I'm sorry. I felt really bad about it being in the fridge, and I don't know why," you say, and to make sure the point hits, you moo afterwards."
			<<elseif $speech_attitude is "bratty">>
				You moo lowly. More like a bull than an obedient cow. "It's fucking pork. It's basically like cannibalism for me. Had to get rid of that."
			<<else>>
				"I felt bad about it being in the fridge, and I don't know why," you say, and to make sure the point hits, you moo afterwards."
			<</if>>
			Avery gaze softens slightly. Just for a moment, it looks like <<he>> understands, or at least suspects why. It doesn't last long though. "I will overlook this one. But you can't just throw out ingredients I buy. They are in the fridge for a reason. You don't need to eat it.<<if $avery_mansion.jobs.includes("kitchen")>> And clean that up.<<else>> And be more careful.<</if>>"<br>
			<br><br>
            Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
		<<elseif (($wolfgirl gte 6 or ($transformationParts.wolf.tail isnot "hidden" and $transformationParts.wolf.tail isnot "disabled")) or ($harpy gte 6 or ($transformationParts.bird.wings isnot "hidden" and $transformationParts.bird.wings isnot "disabled")) or ($cat gte 6 or ($transformationParts.cat.tail isnot "hidden" and $transformationParts.cat.tail isnot "disabled")) or ($bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled")) or ($fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled")))>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I wanted some raw meat," you start your explanation. "I'm a <<animalpc>>, so I think it's just natural for me."<br>
			<<elseif $speech_attitude is "bratty">>
				"I'm a <<animalpc>>, so I just took some raw meat. I'm a carnivore after all."<br>
			<<else>>
				"I craved raw meat," you start your explanation. "I'm a <<animalpc>>. And it means I'm sort of a half-carnivore. I need meat. It makes me happy."<br>
			<</if>>
            <br><br>
			"I did ask for that explanation, didn't I? Just take it. And make sure you cook it for me properly. The last thing I need is to get sick from undercooked meat again."
            <br><br>
			<<He>> turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>><<if $avery_mansion.jobs.includes("kitchen")>> Avery didn't mention it, but you probably still have to clean that kitchen.<</if>> <<tending_pick $phase 2 4>>
		<<else>>
			<<if $speech_attitude is "meek" or $speech_attitude_avery>>
				"I was planning to make <<recipe_name $phase2 "article">>," you explain.
			<<elseif $speech_attitude is "bratty">>
				"I wanted to make <<recipe_name $phase2 "article">>," you say nonchalantly.
			<<else>>
				"I wanted to make <<recipe_name $phase2 "article">>," you say smoothly.
			<</if>>
			<<if ($foodstuff[$phase2].recipe)>>
				If only you knew how to make it.
                <br><br>
				"<<recipe_name $phase2 "cap">>?" Avery raises <<his>> eyebrow. "I didn't know you could cook <<recipe_name $phase2 "article">>. Aren't you full of surprises? <<if $avery_mansion.jobs.includes("kitchen")>>Still - you must clean up.<<else>>Still - you should be more careful with your cooking experiments.<</if>>
			<<else>>
				<br><br>
				"Makes sense," <<he>> answers, <<his>> curiosity satisfied. <<if $avery_mansion.jobs.includes("kitchen")>>"Just clean this up."<<else>>"Just be more careful."<</if>>
			<</if>>
			<br><br>
            Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
		<</if>>
	<<case "white_wine" "red_wine">>
		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"I wanted to pour myself some <<recipe_name $phase2>>, but I knocked a jar off by accident," you explain. "I'm so sorry."
		<<elseif $speech_attitude is "bratty">>
			"Just wanted to drink some <<recipe_name $phase2>>, but the jar was in my way," you shrug.
		<<else>>
			"I wanted to pour myself some <<recipe_name $phase2>>, but I knocked a jar off," you explain.
		<</if>>
		<br><br>
        "Right," <<he>> sighs. "At least you didn't knock the wine bottles down. Still - if you want to drink, I have a collection of much better quality beverages. Those here are for cooking only. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>"
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<<default>>
		<<if $speech_attitude is "meek" or $speech_attitude_avery>>
			"I was planning to make <<recipe_name $phase2 "article">>," you explain.
		<<elseif $speech_attitude is "bratty">>
			"I wanted to make <<recipe_name $phase2 "article">>," you say nonchalantly.
		<<else>>
			"I wanted to make <<recipe_name $phase2 "article">>," you say smoothly.
		<</if>>
		<<if ($foodstuff[$phase2].recipe)>>
			If only you knew how to make it.
            <br><br>
			"<<recipe_name $phase2 "cap">>?" Avery raises <<his>> eyebrow. "I didn't know you could cook <<recipe_name $phase2 "article">>. Aren't you full of surprises? <<if $avery_mansion.jobs.includes("kitchen")>>Still - you must clean up.<<else>>Still - you should be more careful with your cooking experiments.<</if>>
		<<else>>
			<br><br>
			"Makes sense," <<he>> answers, <<his>> curiosity satisfied. <<if $avery_mansion.jobs.includes("kitchen")>>Just clean this up.<<else>>Just be more careful.<</if>>
		<</if>>
		<br><br>
        Avery turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<</switch>>
	<br><br>
	<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>
<<else>>
	You try to think of any excuse, <span class="red">but nothing comes to your mind.</span>
    <br><br>
	<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
		"So that's how it is?" Avery's eye twitches. "I take you in, provide for you, and you come here to steal from me to do what? Sell it yourself and get away from me? You have the nerve." <<He>> gets closer and grabs your arm.<<garage>><<gtrauma>><<gstress>><<npcincr Avery rage 3>><<trauma 6>><<stress 6>>
		<br><br>
		<<link [[Next|Kitchen Steal Fight]]>><<set $fightstart to 1>><</link>>
		<br>
	<<else>>
		"What's the matter?" Avery asks. "You have everything you need in my kitchen. So don't take it anywhere else, hm?<<if $avery_mansion.jobs.includes("kitchen")>> Clean it up.<</if>>"<<npcincr Avery rage 1>><<garage>>
		<br><br>
        <<He>> turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
		<br><br>
		<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>
	<</if>>	
	<<set $weekly.theft.avery_mansion.Ban = true>>
<</if>>

:: Mansion Steal Orphans
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I felt bad for other orphans and wanted to share..."
<<elseif $speech_attitude is "bratty">>
	"Bailey's cheap with money, so I wanted to give some to the orphans."
<<else>>
	"I wanted to give it to other orphans."
<</if>>
<br><br>
Avery stares at you for a good while, fighting <<his>> emotions.
<br><br>
<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
	"So that's how you're repaying me?" Avery's eye twitches. "I take you in, provide for you, and you come here to steal from me to give to some orphans you have no interest in associating with?  You have the nerve." <<He>> gets closer and grabs your arm.<<garage>><<gtrauma>><<gstress>><<npcincr Avery rage 3>><<trauma 6>><<stress 6>>
	<br><br>
	<<link [[Next|Kitchen Steal Fight]]>><<set $fightstart to 1>><</link>>
	<br>
<<else>>
	"So you wanted to steal from me. Great." Avery scoffs, but keeps <<himself>> relatively calm. "Bailey is feeding the orphans enough, and this is my food. So put it down, these kids won't starve, and you should forget about them quickly."<<npcincr Avery rage 1>><<garage>>
	<br><<He>> turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<br><br>
	<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>
<</if>>
<<set $weekly.theft.avery_mansion.Ban = true>>

:: Mansion Steal Admit
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<set $weekly.theft.avery_mansion.Ban = true>>
<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I'm sorry," you mumble. "I tried to steal from you."
<<elseif $speech_attitude is "bratty">>
	"I might have been trying to steal from you."
<<else>>
	"I'm sorry," you start. "I tried to steal from you."
<</if>>
<br><br>
<<if $averyragerevealed is 1 and C.npc.Avery.rage gte random(20, 100)>>
	"So that's how it is?" Avery's eye twitches. "I take you in, provide for you, and you come here to steal from me to do what? Sell it yourself and get away from me? You have the nerve." <<He>> gets closer and grabs your arm.<<garage>><<gtrauma>><<gstress>><<npcincr Avery rage 3>><<trauma 6>><<stress 6>>
	<br><br>
	<<link [[Next|Kitchen Steal Fight]]>><<set $fightstart to 1>><</link>>
	<br>
<<else>>
	"You did what?" Avery's tone changed to a sharper one. "You better have a good excuse for that."
    <br><br>
	<<averyStealResponse>>
<</if>>

:: Mansion Steal Cooking Calm
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<set $skulduggerydifficulty to 400>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
	"I wanted to cook <<recipe_name $phase2 "article">>." You answer almost automatically, as if you didn't come up with that on the spot.
    <br><br>
	Avery raises <<his>> eyebrow in surprise. "<<recipe_name $phase2 "cap">>? There are no <<recipe_name $phase "plural">> in <<recipe_name $phase2 "article">>." <<He>> looks suspicious.
    <br><br>
	<<link [[Say you're experimenting|Mansion Steal Cooking Calm Lie]]>><</link>><br>
	<<link [[Admit to lying|Mansion Steal Cooking Calm Truth]]>><</link>>
<<else>>
	"I wanted to cook... <<recipe_name $phase2 "article">>?" You manage to get a recipe name that you assume is made with <<recipe_name $phase>>.<br>
	Avery raises <<his>> eyebrow in suspicion. Soon after - <<he>> smirks "<<recipe_name $phase2 "cap">>? I didn't know you knew this one." <<He>> stops for a moment. "Alright. Change of plans. <span class="pink">Make <<recipe_name $phase2 "article">> instead of <<recipe_name $avery_mansion.food "article">></span>."<<set $daily.avery.fakeRequest to $phase2>> Avery smirks. 
    <br><br>
	<<if $avery_mansion.jobs.includes("kitchen")>>
		"Oh, and don't forget to clean the kitchen up afterwards."<br>
		<<if $avery_mansion.schedule is "dinner">><<He>> turns on <<his>> heel and returns to the dining room. You will have to come back to it later. For now, Avery is hungry.<<else>><<He>> turns on <<his>> heel and leaves the kitchen. You are in trouble.<</if>>
	<<else>>
		<<He>> turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
	<</if>>
	<br><br>
	<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>
<</if>>

:: Mansion Steal Cooking Calm Lie
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<set $skulduggerydifficulty to 800>><<skulduggerycheck "silent">>
<<if $skulduggerysuccess is 1>>
	<<if $speech_attitude is "meek" or $speech_attitude_avery>>
		"I wanted to try something new, so I tried to experiment."
	<<else>>
		"I'm experimenting." You answer confidently.
	<</if>>
    <br><br>
	<<if $housekeeping gte 200>>
		Avery looks you in the eyes for a moment before <<his>> frown disappears from <<his>> face. "Obviously you do. You are a <<if $housekeeping gte 600>>great<<else>>good<</if>> cook. <<if $avery_mansion.jobs.includes("kitchen")>>Just remember clean the mess up after you finish."<</if>>
	<<else>>
		Avery sighs."Don't. You aren't exactly the most experienced cook out there. Stick to the recipes. At least for now."<<if $avery_mansion.jobs.includes("kitchen")>> <<He>> stops for a moment. "Regardless, clean the mess up when you finish."<</if>>
	<</if>>
<<else>>
	"I was thinking about mixing some <<recipe_name $phase>> with <<recipe_name $phase2>>, yeah." You aren't exactly sure of your answer.
    <br><br>
	"Stop lying to me," Avery frowns. "I expect better of you in the future.<<if $avery_mansion.jobs.includes("kitchen")>> Now, clean it up.<</if>><<llove>><<npcincr Avery love -1>>
	<<set $weekly.theft.avery_mansion.Ban = true>>
<</if>>
<br><br>
<<He>> turns on <<his>> heel and <<if $avery_mansion.schedule is "dinner">>returns to the dining room.<<else>>leaves the kitchen.<</if>>
<br><br>
<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>

:: Mansion Steal Cooking Calm Truth
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>
<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I'm sorry... I lied," you admit. "I hoped to find a good excuse."
<<elseif $speech_attitude is "bratty">>
	"I lied," you admit. "I didn't plan to cook anything, just wanted to get an excuse."
<<else>>
	"I actually lied," you admit. "I didn't plan to cook anything, it was just an excuse."
<</if>>
<br><br>
"Excuse for what?" Avery's tone changed to a sharper one, though <<he>> is willing to hear you out if you've got any excuses left.
<br><br>
<<averyStealResponse>>

:: Mansion Steal Bury Egg
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I just wanted to bury the egg," you start your explanation. "I really felt like I needed to."
<<elseif $speech_attitude is "bratty">>
	"I felt the need to bury an egg, so I took the egg," you say it as if it was the most obvious thing in the world
<<else>>
	"I wanted to bury the egg," you say it as if it was the most obvious thing in the world.
<</if>>
<br><br>
Avery stares at you, as if waiting for you to explain. When that explanation doesn't come - <<he>> laughs. "You wanted to bury it. Obviously. I suppose you do look the part. 
<<if $avery_mansion.jobs.includes("kitchen")>>
	Well, you still have to clean it up, my <<= $player.gender_appearance is "m" ? "kit" : "vixen">>." <<He>> sighs. "Take that egg, just don't break anything more.
<<else>>
	Just leave that for the maids to clean." <<He>>  stops and then sighs. "You can take that egg, just don't break anything more.
<</if>>"
<br><br>
<<if $avery_mansion.schedule is "dinner">><<He>> turns on <<his>> heel and returns to the dining room. You will have to come back to it later. For now, Avery is hungry.<<else>><<He>> turns on <<his>> heel and leaves the kitchen.<</if>>
<<tending_pick $phase 1 1>>
<br><br>
<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>

:: Mansion Steal Save
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I thought I'll need <<recipe_name $phase "plural">> for the cooking in the furue. I didn't want to worry about you having to stock it up anymore."
<<elseif $speech_attitude is "bratty">>
	"You stock only three ignredients at once, and I'll need <<recipe_name $phase "plural">> in the future, so decided to stock on it early on."
<<else>>
	"I wanted to keep it for the future. I'll need <<recipe_name $phase "plural">> for the cooking in the furue, but I need to ask for more ingredients."
<</if>>
<br><br>
<<if $avery_mansion.kitchen_stock.requested.shift() is $phase>>
	<<set $avery_mansion.kitchen_stock.requested.pushUnique($phase)>>
	<<set _removed_ingredient to $avery_mansion.kitchen_stock.requested.shift()>>
	Avery nods. "I'll keep that in mind. Next time I'll get rid of <<recipe_name _removed_ingredient "plural">> instead." 
<<else>>
	Avery sighs. "I wouldn't have gotten rid of that. Though you are correct, I can't stock this much food. I'll get rid of <<recipe_name $avery_mansion.kitchen_stock.requested.shift() "plural">> next, don't worry."
<</if>>
<br><br>
 "Leave the <<recipe_name $phase "plural">>, I'm not taking it anywhere. And <<if $avery_mansion.jobs.includes("kitchen")>>clean up this mess.<<else>>be more careful in the future.<</if>>"<br>
<br><br>
<<if $avery_mansion.schedule is "dinner">><<He>> turns on <<his>> heel and returns to the dining room. You will have to come back to it later. For now, Avery is hungry.<<else>><<He>> turns on <<his>> heel and leaves the kitchen.<</if>>
<br><br>
<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>

:: Mansion Steal Save Fail
<<set $location to "avery_mansion">><<set $avery_passage to $passage>><<set $outside to 0>><<effects>><<avery_mansion>>

<<if $speech_attitude is "meek" or $speech_attitude_avery>>
	"I thought I'll need <<recipe_name $phase "plural">> for the cooking in the furue. I didn't want to worry about you having to stock it up anymore."
<<elseif $speech_attitude is "bratty">>
	"You stock only three ignredients at once, and I'll need <<recipe_name $phase "plural">> in the furue, so decided to stock on it early on."
<<else>>
	"I wanted to keep it for the future. I'll need <<recipe_name $phase "plural">> for the cooking in the furue, but I need to ask for more ingredients."
<</if>>
<br><br>
"What do you mean keep it for the future? I always provide it." Avery frowns. "You should pay more attention to what's in the fridge. <<if $avery_mansion.jobs.includes("kitchen")>>Leave it and clean up this mess.<<else>>leave it and don't repeat that.<</if>> The <<recipe_name $phase "plural">> aren't going anywhere."
<br><br>
"Leave the <<recipe_name $phase "plural">>, I'm not taking it anywhere. And <<if $avery_mansion.jobs.includes("kitchen")>>clean up this mess.<<else>>be more careful in the future.<</if>>"<<npcincr Avery rage 1>><<garage>><<gstress>><<stress 6>><br>
<br><br>
<<if $avery_mansion.schedule is "dinner">><<He>> turns on <<his>> heel and returns to the dining room. You will have to come back to it later. For now, Avery is hungry.<<else>><<He>> turns on <<his>> heel and leaves the kitchen.<</if>>
<br><br>
<<set $weekly.theft.avery_mansion.Ban = true>>
<<icon "avery_kitchen.png">><<link [[Next|Mansion Kitchen]]>><</link>>

:: Mansion Steal Cooking Valid Calm
