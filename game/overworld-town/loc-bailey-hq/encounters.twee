:: Bailey HQ Outskirts Stalk
<<if $molestationstart is 1>>
	<<set $molestationstart to 0>>
	<<violence 1>>
	<<neutral 1>>

	<<maninit>>
	<<stalk_init>>
	<<set $combatgoal to "confront">>
	<<set $NPCList[0].bold to 10000>>
	<<if $baileyHQ.alertness gte 40>>
		<<set $NPCList[0].skills to {athletics: random(1000, 2000), security: random(1000, 2000)}>>
	<<elseif $baileyHQ.alertness gte 25>>
		<<set $NPCList[0].skills to {athletics: random(750, 1500), security: random(750, 1500)}>>
	<<else>>
		<<set $NPCList[0].skills to {athletics: random(500, 1000), security: random(500, 1000)}>>
	<</if>>
<</if>>

<<effects>>

<<effectsman>><<man>>

<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or $stalk_end>>
	<span id="next"><<link [[Next|Bailey HQ Outskirts Stalk Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Bailey HQ Outskirts Stalk]]>><</link>></span><<nexttext>>
<</if>>

:: Bailey HQ Outskirts Stalk Finish
<<effects>>
<<if $enemyhealth lte 0>>
	<<if Time.dayState isnot "night">>
		The <<group>> staggers back, giving you the chance you need. <<tearful>> you escape into the crowds. <span class="red">They're bound to be more alert now.</span>
		<br><br>
	<<else>>
		The <<group>> staggers back, giving you the chance you need. <<tearful>> you escape into the darkness. <span class="red">They're bound to be more alert now.</span>
		<br><br>
	<</if>>
	<<set $baileyHQ.alertness += 10>>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Elk Street]]>><<set $eventskip to 1>><</link>>

<<elseif $enemyarousal gte $enemyarousalmax and ($combatExtended.reverseRapeStart is 0 or $combatExtended.reverseRapeEnd is 1)>>
	<<ejaculation>>

	They put something over your mouth and you passout immediately.
	<br><br>
	<<set $baileyHQ.alertness -= 10>>
	<<endcombat>>

	<<passoutbaileyhq>>

<<elseif $stalk_end is "escaped">>
	You slow to a walk. <<tearful>> you consider your options. <span class="red">They're bound to be more alert now.</span>
	<br><br>
	<<set $baileyHQ.alertness += 10>>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Elk Street]]>><<set $eventskip to 1>><</link>>

<<elseif $stalk_end is "hide">>
	<<tearful>> you emerge from your hiding place. You consider your options. <span class="red">They're bound to be more alert now.</span>
	<br><br>
	<<set $baileyHQ.alertness += 10>>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Elk Street]]>><<set $eventskip to 1>><</link>>

<<else>>
	The group walks ahead. <<tearful>> you consider your options.
	<br><br>
	<<clotheson>>
	<<endcombat>>

	<<link [[Next|Elk Street]]>><<set $eventskip to 1>><</link>>

<</if>>

