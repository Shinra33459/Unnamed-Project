:: Striking Lesson
<<if $mmagymintro is 1 and $phase is 0>><<pass 20>><</if>>
<<set $outside to 0>><<set $location to "mma_gym">><<effects>>

<<if $mmagymintro isnot 1>>
	<<mmaGymIntro "Striking Lesson">>
<<else>>
    <<tiredness 4>><<npc Riley>><<person1>>
    <<cleareventpool>>
    <<if !$usedEvents.includes(0)>>
        <<addinlineevent "Precision Target Drills">>
            /* Riley holds up focus mitts, tapping them lightly. "I call it, you hit it. No wild swings, no guessing. Eyes on the target. 20 minutes." */
            /* <br><br> */

            /* You take your stance, fists ready. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Each hit lands exactly where Riley calls it. Chin, temple, ribs—every strike is clean, no wasted movement. */
                /* <br><br> */
                /* Riley gives a rare nod. "That's precision. Keep that up." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* Your strikes mostly hit the mark, but a few land slightly off. Your accuracy is good, but not perfect. */
                /* <br><br> */
                /* Riley grunts. "You need to sharpen up. No half-measures." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* Your punches connect, but not exactly where they should. You react a little late, and Riley has to correct your form. */
                /* <br><br> */
                /* Riley exhales. "Close isn't good enough in a fight." */
            <<else>><<striking 12>><<physique 1>>
                /* Your timing is completely off. Your strikes are slow, wild, and nowhere near the target. */
                /* <br><br> */
                /* Riley sighs. "If you miss that much in a real fight, you won't get another chance." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<if !$usedEvents.includes(1)>>
        <<addinlineevent "Heavy Bag Power Strikes">>
            /* Riley stands behind the heavy bag, arms crossed. "No taps, no flicks—real hits. If I don't see that bag move, it doesn't count. 20 minutes." */
            /* <br><br> */

            /* You square up and start throwing punches. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Every strike sends the bag rocking. Your fists land solid, and Riley doesn't even have to correct you. */
                /* <br><br> */
                /* Riley gives a slight nod. "That's power. Don't lose it." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* Your punches have weight, but some lack force. The bag moves, but Riley isn't impressed. */
                /* <br><br> */
                /* Riley grunts. "Hit like you mean it." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* Your form is inconsistent. Some hits land solid, but others barely budge the bag. */
                /* <br><br> */
                /* Riley exhales. "You'd get laughed out of a real fight with those." */
            <<else>><<striking 12>><<physique 1>>
                /* Your punches are weak. The bag barely shifts, and your arms already feel heavy. */
                /* <br><br> */
                /* Riley shakes their head. "Embarrassing. You better fix that." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<if !$usedEvents.includes(2)>>
        <<addinlineevent "Sandbag Guard Breakers">>
            /* The dense sandbag swings slowly in front of you. Riley stands off to the side. "Hit through it. No stopping, no hesitation. Break the guard. 20 minutes." */
            /* <br><br> */

            /* You brace yourself and throw your first strike. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Your punches crash into the sandbag, keeping it moving. Every strike lands clean, no wasted effort. */
                /* <br><br> */
                /* Riley grunts. "That's how you smash through a defense." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* Your hits are strong, but not fluid. The bag swings unevenly, forcing you to adjust. */
                /* <br><br> */
                /* Riley exhales. "Still too stiff. You need to flow between strikes." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* Some punches land solid, but others barely connect. The bag swings too wildly, and you struggle to keep rhythm. */
                /* <br><br> */
                /* Riley frowns. "A sloppy offense won't break anything." */
            <<else>><<striking 12>><<physique 1>>
                /* Your strikes are weak and inconsistent. You miss the timing completely, losing control of the bag. */
                /* <br><br> */
                /* Riley shakes their head. "That ain't breaking anything. Try harder next time." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<if !$usedEvents.includes(3)>>
        <<addinlineevent "Counterstrike Reflex Drills">>
            /* Riley raises the focus mitts. "Dodge, then strike. No pauses, no hesitation. 20 minutes." */
            /* <br><br> */

            /* You focus, waiting for Riley's cue. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Your dodges are sharp, and your counters land instantly. No wasted motion, no hesitation. */
                /* <br><br> */
                /* Riley nods. "That's how you punish a mistake." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* You land most of the counters, but some are mistimed. Your reactions aren't perfect yet. */
                /* <br><br> */
                /* Riley grunts. "Too slow. Speed it up." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* Your dodges are shaky, and your punches don't land clean. You're reacting, but not fast enough. */
                /* <br><br> */
                /* Riley frowns. "You'd already be eating a punch by now." */
            <<else>><<striking 12>><<physique 1>>
                /* Your timing is a mess. Your counters are wild and uncoordinated. */
                /* <br><br> */
                /* Riley shakes their head. "That ain't a counter, that's panic swinging." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<if !$usedEvents.includes(4)>>
        <<addinlineevent "Rapid Combination Training">>
            /* Riley raises the mitts. "You follow my call. No stalling, no stopping. If you mess up, recover fast. 20 minutes." */
            /* <br><br> */

            /* You get into position, waiting for the call. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Your combos flow effortlessly. No pauses, just clean strikes. */
                /* <br><br> */
                /* Riley smirks. "You can actually follow directions. Good." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* You keep up, but some transitions are rough. */
                /* <br><br> */
                /* Riley grunts. "You hesitate too much. Smooth it out." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* You struggle to keep up. The pace is too fast, and your strikes are sloppy. */
                /* <br><br> */
                /* Riley frowns. "That ain't fluid. You're forcing it." */
            <<else>><<striking 12>><<physique 1>>
                /* Your hands can't keep up. You miss hits and lose track of the sequence. */
                /* <br><br> */
                /* Riley shakes their head. "That's ugly. Try again next time." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<if !$usedEvents.includes(5)>>
        <<addinlineevent "Sandbag Stability Punches">>
            /* Riley drops a sandbag into your arms. "You throw a punch, this stays put. If I see you stumble or lean, I'll know you're off balance. 20 minutes." */
            /* <br><br> */

            /* You brace yourself, adjusting your stance before throwing the first punch. */
            <<if $combatExtended.striking gte 600>><<striking 8>><<physique 1>>
                /* Your feet stay grounded, your core locked in. Every strike lands clean without shifting your balance. */
                /* <br><br> */
                /* Riley gives a short nod. "That's control. Keep it." */
            <<elseif $combatExtended.striking gte 400>><<striking 9>><<physique 1>>
                /* Most of your punches are solid, but a few cause you to shift slightly. You recover fast, but Riley notices. */
                /* <br><br> */
                /* Riley grunts. "You feel that? That's a mistake. Fix it." */
            <<elseif $combatExtended.striking gte 200>><<striking 10>><<physique 1>>
                /* Your stance keeps shifting. Some punches land well, but others throw you slightly off balance. */
                /* <br><br> */
                /* Riley frowns. "You're hitting, but you're not grounded. That's dangerous." */
            <<else>><<striking 12>><<physique 1>>
                /* Your form is completely off. Every punch pushes you off-center, forcing you to readjust constantly. */
                /* <br><br> */
                /* Riley shakes their head. "If you're off balance, you're dead weight. Get stronger." */
            <</if>>
        <</addinlineevent>>
    <</if>>
    <<runeventpool>>
    /* <br><br> */
    <<if $gymstage gte 2>>
        /* Riley checks the time. "That is 20 minutes. Session's over. Go, I have others to train." */
        /* <br><br> */

        <<link [[Next|MMA Gym]]>><<endevent>><</link>>
    <<else>>
        /* Riley checks the time. "That is 20 minutes. Next station. Do not waste my time." */
        /* <br><br> */

        <<link [[Next|Striking Lesson]]>><<set $gymstage += 1>><<endevent>><</link>>
    <</if>>
<</if>>
