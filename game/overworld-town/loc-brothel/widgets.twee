			<<set _sex to _service.chest.sex>>
			<<set _rounds to _service.chest.rounds>>
			<<set _time to _service.chest.time>>
			<<chestskill _rounds>><<cheststat>>
			<<if $NPCList[0].penis isnot "none">>
				<<set $NPCList[0].penis to "chest">>
			<</if>>
