					<</if>>
					<<if $NPCList[0].virginity.penile is true>>
						<<set $gloryHoleEvent.virginity.pushUnique("npc")>>
					<</if>>
					<<set $NPCList[0].penis to "mouth">>
				<<case "vaginal">>
					<<set $NPCList[0].vagina to "mouth">>
			<</switch>>
