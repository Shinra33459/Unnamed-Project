        <<hbscOptions>>
    <</if>>
<</if>> */

:: HSBC Bank Lobby
<<set $outside to 0>><<effects>><<location "hbsc">>
<<if bankOpen()>>
    You are inside the bank.
    <<if !$per_npc.bank_teller>>
        <<generate1>><<saveNPC 0 "bank_teller">><<person1>>
    <<else>>
        <<loadNPC 0 "bank_teller">><<person1>>
    <</if>>

<<else>>
    You are alone in the bank.
<</if>>

:: HSBC Bank Wait
