<<widget "poppyLakeReturn">>
	<<run poppySchedule()>>
	<<if !C.npc.Poppy or C.npc.Poppy.init isnot 1 or T.poppy_location isnot "lake" or Time.minutesSinceMidnight lt 540 or Time.minutesSinceMidnight gte 720 or Weather.precipitation is "rain" or Weather.precipitation is "snow">>
		Poppy glances at <<his>> watch. "Oh, look at the time."
		<br><br>
		<<link [[Next|Lake Poppy Departure]]>><<set $eventskip to 0>><</link>>
	<<else>>
		<<set $eventskip to 1>>
		<<poppyLakeMenu>>
	<</if>>
<</widget>>

<<widget "poppyFlatsMenu">>
<<set $bus to "poppy_living_room">><<effects>><<run poppySchedule()>><<bodywritingExposureCheck>>
	<<set _poppyPostAction to ($eventskip is 1)>><<set _poppyFreshEntry to ($eventskip isnot 1)>>
	<<set _poppyLeaveNow to (!C.npc.Poppy or C.npc.Poppy.init isnot 1 or !$poppyFlat.home or $poppyFlat.room isnot "living_room")>>

	/* Fresh entry: direct scene injection is fine */
	<<if _poppyFreshEntry and _poppyLeaveNow>>
		<<include "Flats Poppy Departure">>
	<<elseif _poppyFreshEntry and $tiredness gte C.tiredness.max>>
		<<include "Flats Poppy Pass Out">>
	<<elseif _poppyFreshEntry and Number($poppyromance) gte 0 and C.npc.Poppy.init is 1 and _bodywriting_exposed gte 1 and !$daily.poppy.bodywriting and _bodypart>>
		<<include "Flats Poppy Bodywriting Reaction">>

	/* Post-action return: use Next links instead of include */
	<<elseif _poppyPostAction and _poppyLeaveNow>>
		Poppy glances at <<his>> watch. "Oh, look at the time."
		<br><br>
		<<link [[Next|Flats Poppy Departure]]>><</link>>
	<<elseif _poppyPostAction and $tiredness gte C.tiredness.max>>
		A sudden wave of exhaustion hits you.
		<br><br>
		<<link [[Next|Flats Poppy Pass Out]]>><</link>>
	<<elseif _poppyPostAction and !$daily.poppy.flatsNap and !$daily.poppy.forceNoNap and !T.poppyStatus.includes("LowPatience") and ($daily.poppy.lastAction is "chat" or $daily.poppy.lastAction is "flirt") and random(1,100) gte 82>>
		<<set $daily.poppy.flatsNap to true>>
		Poppy looks rather drowsy.
		<br><br>
		<<link [[Next|Flats Poppy Doze]]>><</link>>
	<<else>>
		<<if _poppyFreshEntry>>
				<<if $awarelevel gte 5>>
					<<if T.poppyStatus and T.poppyStatus.includes("LowPatience")>>
						Poppy's fox ears twitch as you get closer. The cushion sinks as you sit down beside Poppy. <<He>> doesn't acknowledge you.
					<<else>>
						Poppy's fox ears twitch as you get closer. <<He>> turns <<his>> head towards you and smiles. The cushion sinks as you sit down beside Poppy.
					<</if>>
				<<else>>
					<<if T.poppyStatus and T.poppyStatus.includes("LowPatience")>>
						The cushion sinks as you sit down beside Poppy. <<He>> doesn't acknowledge you.
					<<else>>
						<<He>> turns <<his>> head towards you and smiles. The cushion sinks as you sit down beside Poppy.
					<</if>>
				<</if>>
			<<poppyOpiumPulse>>
		<</if>>
		<<if !$poppySeen.includes("flat_chat_plant") and Number($poppyromance) gte 0>>
			<<socialiseicon>><<link [[Chat (0:15)|Flats Poppy Chat Plant]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<if C.npc.Poppy.patience gt 0>><<gpatience>><<else>><<langer>><</if>>
			<br>
		<<else>>
			<<socialiseicon>><<link [[Chat (0:15)|Flats Poppy Chat]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<if C.npc.Poppy.patience gt 0>><<gpatience>><<else>><<langer>><</if>>
			<br>
		<</if>>
		<<socialiseicon>><<link [[Flirt (0:15)|Flats Poppy Flirt]]>><<pass 15>><<set $daily.poppy.lastAction to "flirt">><</link>><<promiscuous1>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<if Number($poppyromance) gte 0 and !T.poppyStatus.includes("LowPatience")>><<glust>><</if>>
		<br>
		<<if $wolfgirl gte 6 or ($transformationParts.wolf.tail isnot "hidden" and $transformationParts.wolf.tail isnot "disabled")>>
			<<tficon "wolf">><<link [[Howl (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "wolf">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled")>>
			<<tficon "fox">><<link [[Yip (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "fox">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")>>
			<<tficon "cow">><<link [[Gently headbutt (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cow">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $harpy gte 6 or ($transformationParts.bird.wings isnot "hidden" and $transformationParts.bird.wings isnot "disabled")>>
			<<birdicon "sing">><<link [[Sing (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "harpy">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $cat gte 6 or ($transformationParts.cat.tail isnot "hidden" and $transformationParts.cat.tail isnot "disabled")>>
			<<tficon "cat">><<link [[Nuzzle (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cat">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled")>>
			<<tficon "bear">><<link [[Lean (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bear">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<<elseif $bunny gte 6 or ($transformationParts.bunny.tail isnot "hidden" and $transformationParts.bunny.tail isnot "disabled")>>
			<<tficon "bunny">><<link [[Headbutt (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bunny">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<if (Number(C.npc.Poppy.patience) || 0) lt 0>><<langer>><<else>><<gpatience>><</if>>
			<br>
		<</if>>
		<<if T.poppyStatus.includes("LowPatience")>>
			<<skinicon "give">><span class="black">Gift food</span> | <span class="red">Poppy is too irritated to accept anything right now.</span>
		<<else>>
			<<skinicon "give">><<link [[Gift food|Flats Poppy Gift Food]]>><<set $daily.poppy.lastAction to "gift">><</link>>
		<</if>>
		<br>
		<<getouticon>><<link [[Leave|Flats Poppy Living Room]]>><<set $eventskip to 0>><</link>>
	<</if>>
<</widget>>

<<widget "poppyChristmasBaileyPayment">>
	While you're speaking to Poppy, you see the door to Bailey's office open behind <<him>> as Bailey comes out to investigate the hubbub caused by Poppy's gift of sweets. <<nnpc_He "Bailey">> doesn't look happy.
	<br><br>
	Poppy notices you looking over <his>> shoulder and turns around to see Bailey. <<He>> approaches Bailey with something in <<his>> hand. 
	<br><br>
	<<if currentSkillValue('skulduggery') gte 200>>
		<span class="teal">With a thief's eye, you see what others miss.</span> Poppy is handing Bailey a small stack of cash.
		<br><br>
	<<elseif hasSharpSenses("sight") or hasSharpSenses("instincts")>>
		Your <span class="green">sharp eyes</span> catch the movement of Poppy's fingers. <<He>> is handing Bailey a small stack of cash.
		<br><br>
	<<else>>
		Bailey's expression changes as Poppy approaches. Whatever Poppy says is too quiet for you to hear.
		<br><br>
	<</if>>
	Bailey takes it and nods <<nnpc_his "Bailey">> head. <<nnpc_He "Bailey">> heads out of the orphanage, likely wanting to get away from the noise.
<</widget>>