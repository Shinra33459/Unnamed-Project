:: Widgets Grimace Cheats [widget]
<<widget "reclaimWhitney">>
<<loveInterestAdd "Whitney">>
 <<npcset Whitney state "active">>
<</widget>>

<<widget "reclaimKylar">>
    <<npcset Kylar state "active">>
    <<if $englishPlay is "ongoing">>
            <<set $englishPlayKylarReplace to false>>
        <</if>>
    <</if>>
    <<loveInterestAdd "Kylar">>
    <br><br>
<</widget>>

<<widget "godClothe">>
<<if $godClothes is undefined>>
     <<set $godClothes to 0>>
	<</if>>
	<<if $godClothes is 0>>
	<<set $godClothes to 0>>
    <<elseif $godClothes is 1>>
	<<set $godClothes to 1>>
	<</if>>
<</widget>>
