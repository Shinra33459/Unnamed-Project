:: Lake House Backyard
<<set $outside to 1>><<effects>>

<<if $stress gte $stressmax and !$possessed>>
	<<if $lakehouse.wall gte 2>>
		<<set $previousPassage to $passage>>
		<<passoutlakehouse>>
	<<else>>
		<<passoutlake>>
	<</if>>
<<else>>
	You step out to your backyard.
	<br><br>

	<<if $lakehouse.plots lt 3>>
		<<set _clearing to (25 - $lakehouse.clearing)>>
		<<set $percent=Math.floor((_clearing/25)*100)>>
		One of the fields is being cleared,
		<<if $lakehouse.clearing lte 0>>
			<span class="green">and is ready for planting!</span>
			<div class="meter">
			<<print '<div class="greenbar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<elseif $lakehouse.clearing lte 5>>
			<span class="teal">and is almost ready for planting.</span>
			<div class="meter">
			<<print '<div class="tealbar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<elseif $lakehouse.clearing lte 10>>
			<span class="lblue">and is starting to look civilised.</span>
			<div class="meter">
			<<print '<div class="lbluebar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<elseif $lakehouse.clearing lte 15>>
			<span class="blue">and soil has been exposed in places.</span>
			<div class="meter">
			<<print '<div class="bluebar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<elseif $lakehouse.clearing lte 20>>
			<span class="purple">but the tangle remains defiant.</span>
			<div class="meter">
			<<print '<div class="purplebar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<elseif $lakehouse.clearing lte 24>>
			<span class="pink">but little progress has been made.</span>
			<div class="meter">
			<<print '<div class="pinkbar" style="width:' + $percent + '%"></div>'>>
			</div>
		<<else>>
			<span class="red">but remains a jungle of weeds.</span>
			<div class="meter">
			<<print '<div class="redbar" style="width:' + $percent + '%"></div>'>>
			</div>
		<</if>>
		<br>
	<</if>>

	<<if $lakehouse.plots lt 3>>
		<<link [[Clear a plot (0:40)|$passage]]>><<pass 40>><<tiredness 4>><<set $lakehouse.clearing -= 1>><<lakehouseclearplot>><</link>><<gtiredness>>
		<br>
	<</if>>
	<<if $lakehouse.plots is 3 and $lakehouse.wetplot is undefined>>
		<<link [[Set up a water plot (4:00)|$passage]]>><<pass 4 hour>><<tiredness 24>><<add_plot lakehouse water 3 medium>><<set $lakehouse.wetplot to 1>><</link>>
		<br>
	<</if>>
	<<link [[Go back into the house (0:01)|Lake House]]>><<pass 1>><</link>>
	<br>

	<<if $lakehouse.plots gte 1>>
		<<display_plot lakehouse>>
	<</if>>
<</if>>


