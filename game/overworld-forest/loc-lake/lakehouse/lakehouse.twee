:: Lake House Outdoor
<<set $outside to 1>><<set $location to "lakehouse">><<effects>>
/* <<run Furniture.in($location)>> */
<<lakehouseinit>>
<<if $lakehouse.build isnot undefined and $lakehouse.build isnot 0>>
	<<switch $lakehouse.build>>
	<<case "wall 1">>
		<span class="lblue">A foundation is being placed.</span>
	<<case "wall 2">>
		<span class="lblue">A modern fence is being built around the lake house.</span>
	<<case "wall 3">>
		<span class="lblue">Barbed wire is being affixed atop the fence.</span>
	<<case "tower 1">>
		<span class="lblue">A tower is being built by the forest.</span>
	<<case "tower 2">>
		<span class="lblue">Searchlights are being affixed atop the watchtower.</span>
	<<case "guard post">>
		<span class="lblue">A guard post is being built.</span>
	<<case "dog training">>
		<span class="lblue">Training facilities is being built.</span>
	<<case "traps 1">>
		<span class="lblue">Traps are being set up around your property.</span>
	<<case "traps 2">>
		<span class="lblue">More traps are being set up around your property.</span>
	<</switch>>
	<<if Time.hour gte 6>>
		<span class="blue">Workers traipse across the lakehouse.</span>
	<</if>>
	<br><br>
<</if>>
<<if $lakehouse.billsphase gte 4>>
	There's a <span class="red">Repossessed</span> notice on your door.
	<br><br>
<<elseif $lakehouse.billsphase gte 2>>
	There's a <span class="red">Bills Overdue</span> notice on your door.
	<br><br>
<</if>>

<<if $stress gte $stressmax and !$possessed>>
	<<if $lakehouse.wall gte 2>>
		<<set $previousPassage to $passage>>
		<<passoutlakehouse>>
	<<else>>
		<<passoutlake>>
	<</if>>
<<else>>
	You are at the lake house. 
	<<if Time.dayState is "night">>
		<<if $weather is "rain">>
			Rainwater drips down the roof.
		<<elseif $weather is "overcast">>
			You can see little in the darkness.
		<<elseif $weather is "snow">>
			Snow covers the path.
		<<else>>
			Stars glimmer over the lake.
		<</if>>
	<<elseif Time.dayState is "dawn">>
		<<if $weather is "rain">>
			Rain sweeps over the lake.
		<<elseif $weather is "overcast">>
			A dense fog devours the lake.
		<<elseif $weather is "snow">>
			Snow blankets the lake.
		<<else>>
			The lake greet the morning sun on the horizon.
		<</if>>
	<<elseif Time.dayState is "dusk">>
		<<if $weather is "rain">>
			Rain blows in from the ocean beneath an ever-darkening sky.
		<<elseif $weather is "overcast">>
			It's already getting hard to see the lake.
		<<elseif $weather is "snow">>
			Snow blows over the lake.
		<<else>>
			The sun sets over the lake.
		<</if>>
	<<else>>
		<<if $weather is "rain">>
			Rainwater feeds the lake.
		<<elseif $weather is "overcast">>
			Grey skies stretch in all directions.
		<<elseif $weather is "snow">>
			Snow covers the lake.
		<<else>>
			The sun beams over fertile lake.
		<</if>>
	<</if>>
	<br><br>

	<<if $lakehouse.billsphase lt 4>>
		<<domusicon>><<link [[Go into the house (0:01)|Lake House]]>><<set $phase to 1>><<pass 1>><</link>>
		<br>
	<<else>>
		/* <<domusicon>><<link [[Go into the house (0:01)|Lake House]]>><<set $phase to 1>><<pass 1>><</link>>
		<br> */
	<</if>>
	<<getouticon>><<link [[Leave|Lake Shore]]>><</link>>
	<br>
<</if>>

:: Lake House
<<set $outside to 0>><<set $location to "lakehouse">><<effects>>
<<lakehouseinit>>
<<if ($lakehouse_countdown lte 0 or $lakehouse_countdown is undefined) and ($renttime lte -2 or ($renttime lte 0 and Time.hour gte 4 and Time.hour lte 21))>>
	<<unset $lakehouse_countdown>><<unset $baileyReunionScene>>
	<span class="red">You hear a knock at the door.</span>
	<br><br>

	<<link [[Answer the door|Lake House Bailey]]>><</link>>
	<br>
/* <<elseif $lakehouse_attack_timer lte 0 and Time.hour gte 21>> */

<<elseif $lakehouse_bills>>
	<spawn class="red">You hear a knock at the door.</span>
	<br><br>
	
	<<link [[Answer the door|Lake House Bills]]>><</link>>
	<br>
<<elseif $stress gte $stressmax and !$possessed>>
	<<set $previousPassage to $passage>>
	<<passoutlakehouse>>
<<else>>
	<<set _tv to Furniture.get('tv')>>
	<<set _gameconsole to Furniture.get('gameconsole')>>

	You enter the living room. 
	<<if _tv>>
		You see your TV sitting on the table in the living room
		<<if _gameconsole>>
			beside your game console
		<</if>>
		. 
	<</if>>
	<<if $lakehouse.petBed isnot undefined>>
		<<if $lakehouse.petBed is 1>>
			In the corner rests an soft looking pet bed
			<<if $lakehouse.pet1 isnot undefined>>
				<<if $lakehouse.pet1.type is "cat">>
					, your cat lies asleep on it
				<<elseif $lakehouse.pet1.type is "dog">>
					, your dog lies asleep on it
				<</if>>
			<</if>>
			. 
		<<elseif $lakehouse.petBed is 2>>
			In the corner lie two soft looking pet beds
			<<if $lakehouse.pet1 isnot undefined>>
				<<if $lakehouse.pet2 isnot undefined>>
					<<if $lakehouse.pet1.type is "cat" and $lakehouse.pet2.type is "cat">>
						, your cats lie asleep in them
					<<elseif $lakehouse.pet1.type is "dog" and $lakehouse.pet2.type is "dog">>
						, your dogs lie asleep in them
					<<elseif ($lakehouse.pet1.type is "cat" and $lakehouse.pet2.type is "dog") or ($lakehouse.pet1.type is "dog" and $lakehouse.pet2.type is "cat")>>
						, your cat and dog lie asleep in them
					<</if>>
				<<else>>
					<<if $lakehouse.pet1.type is "cat">>
						, your cat lies alseep in one
					<<elseif $lakehouse.pet1.type is "dog">>
						, your dog lies asleep in one
					<</if>>
				<</if>>
			<</if>>
			. 
		<</if>>
	<</if>>
	<br><br>

	<<bedroomicon>><<link [[Go to bedroom|Lake House Bedroom]]>><</link>>
	<br>
	<<bathroomicon>><<link [[Go to bathroom|Lake House Bathroom]]>><</link>>
	<br>
	<<gardenicon>><<link [[Go to backyard|Lake House Backyard]]>><</link>>
	<br>
	<<if _tv>>
		<<if $lakehouse.billsphase gte 3>>
		You can't use your TV without power.
		<br>
		<<else>>
			<<link [[Watch TV|Lake House TV]]>><</link>>
			<br>
		<</if>>
	<</if>>
	<<if _tv and _gameconsole>>
		<<if $lakehouse.billsphase gte 3>>
			You can't use your console without power.
			<br>
		<<else>>
			<<link [[Play console(0:30)|Lake House Console]]>><<trauma -3>><<set $handskill += 1>><</link>><<ghandskill>>
			<br>
		<</if>>
	<</if>>
	<<if $lakehouse.pet1.type is "cat" and $lakehouse.pet2.type is "cat">>
		<<link [[Snuggle cat(0:30)|Lake House Snuggle Cats]]>><<pass 30>><<stress -25>><<trauma -25>><</link>><<lllstress>><<llltrauma>>
		<br>
	<<elseif $lakehouse.pet1.type is "cat" or $lakehouse.pet2.type is "cat">>
		<<link [[Snuggle cat(0:30)|Lake House Snuggle Cat]]>><<pass 30>><<stress -10>><<trauma -10>><</link>><<llstress>><<lltrauma>>
		<br>
	<</if>>
	<<if $lakehouse.pet1.type is "dog" and $lakehouse.pet2.type is "dog">>
		<<link [[Play fetch with Dogs(1:00)|Lake House Fetch Dogs]]>><<pass 60>><<stress -25>><<trauma -25>><<physique 3>><<tiredness 3>><</link>><<lllstress>><<llltrauma>><<gphysique>><<gtiredness>>
		<br>
	<<elseif $lakehouse.pet1.type is "dog" or $lakehouse.pet2.type is "dog">>
		<<link [[Play fetch with Dog(1:00)|Lake House Fetch Dog]]>><<pass 60>><<stress -10>><<trauma -10>><<physique 3>><<tiredness 3>><</link>><<llstress>><<lltrauma>><<gphysique>><<gtiredness>>
		<br>
	<</if>>
	<<if ($lakehouse.pet1.type is "cat" or $lakehouse.pet2.type is "cat") and $deviancy gte 15>>
		<<link [[Fuck cat|Lake House Fuck Cats]]>><<pass 30>><</link>><<deviant2>>
		<br>
	<</if>>
	<<if ($lakehouse.pet1.type is "cat" and $lakehouse.pet2.type is "cat") and $deviancy gte 35>>
		<<link [[Fuck cats|Lake House Fuck Cats]]>><<pass 60>><</link>><<deviant3>>
		<br>
	<</if>>
	<<if ($lakehouse.pet1.type is "dog" or $lakehouse.pet2.type is "dog") and $deviancy gte 15>>
		<<link [[Fuck dog|Lake House Fuck Dog]]>><<pass 30>><</link>><<deviant2>>
		<br>
	<</if>>
	<<if ($lakehouse.pet1.type is "dog" and $lakehouse.pet2.type is "dog") and $deviancy gte 35>>
		<<link [[Fuck dogs|Lake House Fuck Dogs]]>><<pass 60>><</link>><<deviant3>>
		<br>
	<</if>>
	/* <<link [[Robin options|Lake House Robin Options]]>><</link>>
	<br> */
	<<link [[Go to basement|Lake House Basement]]>><</link>>
	<br>
	<<getouticon>><<link [[Leave|Lake House Outdoor]]>><</link>>
	<br>
<</if>>

:: Lake House Bedroom
<<lakehouseinit>>
<<bedclotheson "Lake House Bed">>
<<set $outside to 0>><<set $location to "lakehouse">><<effects>>
	<<if $lakehouse.barrier is undefined>>
		<<getTarget true>>
	<</if>>
<<if $stress gte $stressmax and !$possessed>>
	<<set $previousPassage to $passage>>
	<<passoutlakehouse>>
<<else>>
	You are in your bedroom.

	<<set _furniture to $furniture.bedroom>>
	<<if _furniture.wallpaper>>
		<<switch _furniture.wallpaper.name>>
			<<case "vines">>
				Lewd green vines writhe on the walls.
				<<if $backgroundTraits.includes("plantlover")>>
					Thoughts of sweet nectar wrack your mind.
				<</if>>
			<<case "tentacles">>
				Purple tentacles slither on the walls.
				<<if $demon gte 6>>
					Thoughts of pleasure cross your mind.
				<</if>>
			<<case "plainwhite">>
				Plain white wallpapers cover the walls.
			<<case "wavywhite">>
				The white wallpapers gradient to black in a wavy pattern. Is there a lewd subtext?
			<<case "hearts">>
				Pink hearts cover the walls.
			<<case "cowgirls">>
				Cowgirls dance on the walls.
			<<case "trees">>
				Green trees bring you a feeling of being in a forest.
			<<case "crosses">>
				Golden crosses cover the walls.
			<<default>> /* Custom */
				Images of _furniture.wallpaper.name cover the walls.
				<<if ['dol', 'degrees of lewdity'].some(e => _furniture.wallpaper.name === e)>>
					Somehow, they look familiar.
				<<elseif _furniture.wallpaper.name.startsWith('&lt;&lt')>>
					<span class="black">You feel like you got caught cheating.</span>
				<</if>>
		<</switch>>
	<<else>>
		Bleak walls protect you from the outside.
	<</if>>

	<<if $furnitureLocation is "lake house">>
		<<set _deco to Furniture.get('decoration')>>
		<<set _owlplush to Furniture.get('owlplushie')>>
		<<set _windowsill to Furniture.get('windowsill')>>
		<<set _bed to Furniture.get('bed')>>
		<<set _wardrobe to Furniture.get('wardrobe')>>
		<<set _table to Furniture.get('table')>>
		<<set _chair to Furniture.get('chair')>>
	<</if>>
	<<set _mirror to Furniture.get('mirror')>>
	<<set _bookshelf to Furniture.get('bookshelf')>>
	<<set _pc to Furniture.get('pc')>>

	<<if _deco>>
		<br>
		<<switch _deco.name>>
			<<case "large bear plushie">>
				<<furnitureicon _deco.iconFile>>The _deco.name is sitting in a corner.
			<<default>>
				<<furnitureicon _deco.iconFile>>The _deco.name is hanging on a wall.
		<</switch>>
	<</if>>

	<<if _owlplush>>
		<br>
		<<switch _owlplush.id>>
			<<case "owlplushie">>
				<<furnitureicon _owlplush.iconFile>>The _owlplush.name stares down from the wardrobe, blending into the gloom.
		<</switch>>
	<</if>>

	<<if _windowsill>>
		<br>
		<<switch _windowsill.name>> /* can be expanded further */
			<<case "ominous jar">> /* unused */
				<<furnitureicon _windowsill.iconFile>>_windowsill.nameCap stands on the windowsill menacingly.
			<<default>>
				<<furnitureicon _windowsill.iconFile>> Your _windowsill.name sits on the windowsill.
		<</switch>>
	<</if>>

	<<if _furniture.poster>>
		<br>
		<<switch _furniture.poster.name>>
			<<case "cowgirl">>
				A cowgirl poster hangs on a wall.
			<<case "cat">>
				A poster of a cat hangs on a wall. The text below reads, "Hang in there!"
			<<case "puppy">>
				A puppy poster hangs on a wall.
			<<default>> /* Custom */
				A poster of _furniture.poster.name hangs on a wall.
				<<if ['dol', 'degrees of lewdity'].some(e => _furniture.poster.name === e)>>
					You feel an odd sense of familiarity.
				<<elseif _furniture.poster.name.startsWith('&lt;&lt;')>>
					<span class="black">You feel like you got caught cheating.</span>
				<</if>>
		<</switch>>
	<</if>>

	<br><br>
	/* <<if $robinbed is "yours" and Time.hour gte 6 and !$possessed>>
		<<unset $robinbed>>
		<<npc Robin>><<person1>>Robin yawns and heads to <<his>> own room.<<endevent>>
		<<if Time.hour is 6 and Time.minute lte 20>><<run setRobinLocationOverride("orphanage", 6)>><</if>>
		<br><br>
	<</if>> */
	<<if $unbind is 1>>
		<<unset $unbind>>
		<<if $possessed>>
			You stare down at your bindings. You pull, and they fall apart, unable to hold against you. <<unbind>>
			<br><br>
		<<else>>
			You rub your bindings against your desk. It takes some effort, but eventually the material yields, freeing your limbs.
			<br><br>
		<</if>>
	<</if>>
	<<if $nextPassageCheck is "Lake House Bedroom">>
		<span class="nextLink"><<link [[Look to the moon.|$passage]]>><</link>></span>
		<br>
	<</if>>
	<<if $stress gte $stressmax and !$possessed>>
		<<set $previousPassage to $passage>>
		<<passoutlakehouse>>
	/* <<elseif $christmas is 1 and Time.monthDay is 25 and $christmas_robin_visit is undefined and $christmas_robin_gift_received is undefined and Time.dayState isnot "night" and $NPCName[$NPCNameList.indexOf("Robin")].init is 1 and !$possessed>>
		<<set $christmas_robin_visit to true>>
		<<christmas_robin_visit>> */
	<<else>>
		<<if $leftarm is "bound" or $rightarm is "bound" or $feetuse is "bound">>
			<<link [[Undo your bindings (0:10)|$passage]]>><<set $unbind to 1>><<pass 10>><<unbind>><</link>>
			<br><br>
		<</if>>
		/* <<if $robinpaid is 1 and $robinmissing is 0 and $robinnote isnot 1 and $NPCName[$NPCNameList.indexOf("Robin")].lust gte 10 and $NPCName[$NPCNameList.indexOf("Robin")].love gte 60 and $NPCName[$NPCNameList.indexOf("Robin")].trauma lt 10>>
			<span class="gold">There's a note by the window.</span>
			<br>
			<<link [[Read it|Robin Note]]>><<set $robinnote to 1>><</link>>
			<br><br>
		<</if>> */
		<<projectoptions>>
		<br><br>
		/* <<christmas_options>> */
		<<if _deco>>
			<br>
			<<if _deco.name is "large bear plushie">>
				<<furnitureicon _deco.iconFile>><<link [[Cuddle with the large bear plushie (0:10)|Lake House Large Bear Plushie Cuddle]]>><<pass 10>><</link>><<ltrauma>><<lstress>>
				<br><br>
			<</if>>
		<</if>>
		

		<<if _bed isnot undefined && _bed.type.includes('comfy')>>
			Your bed takes up most of the room.
			<<if $nextPassageCheck is "Lake House Bed">>
				<br>
				<<listsleepoutfits "Lake House Bed">>
			<<elseif $slimeEvent is undefined>>
				<br>
				<<furnitureicon _bed.iconFile>><<link [[Strip and get in bed|Lake House Bed]]>><<undressSleep "Lake House Bed">><</link>>
				<br>
				<<listsleepoutfits "Lake House Bed">>

				<<if !_bed.type.includes("starter")>>
					<<furnitureicon _bed.iconFile>><<link [[Masturbate in bed|Lake House Masturbation]]>><<set $masturbationstart to 1>><</link>>
					<br>
				<</if>>
			<<else>>
				<br>
				<<if $possessed and $lakehouse.barrier is undefined>>
					<span class="red">The slime in your head is silent.</span>
				<<else>>
					<span class="red">The slime wants you to <<print $slimeEvent>> before you can go to bed.</span>
				<</if>>
				<br>
			<</if>>
		<<else>>
			You don't have a bed yet. Bailey won't let you take the one in the orphanage.
			<br>
		<</if>>
		<<roomoptions>>
		<br>
		
		<<if _wardrobe isnot undefined && !_wardrobe.type.includes("starter")>>
			<<if _wardrobe>>
				Your clothes are kept in the wardrobe.
			<</if>>
			<br>
			<<furnitureicon _wardrobe.iconFile>><<link [[Wardrobe|Lake House Wardrobe]]>><</link>>
			<br>
		<<else>>
			You don't have a wardrobe yet. Bailey won't let you take the one in the orphanage.
			<br>
		<</if>>
		<<if playerHasSexToys()>>
			<<sextoysicon>><<link [[Sex toys|Sextoys Inventory]]>><<set $sextoyInvReturnLink to $passage>><</link>>
			<br>
		<</if>>
		
		<<if _mirror>>
			<<if $nextPassageCheck is "Lake House Mirror">>
				<span class="nextLink"><<mirroricon>><<link [[Mirror|Lake House Mirror]]>><</link>></span>
				<br>
			<<elseif $christmas is 1 and !$christmas_wraith and _wraithEvent>>
				<br>
				<span class="purple">You catch a strange glint in your mirror.</span>
				<br>
				<<bloodmirroricon>><<link [[Mirror|Christmas Mirror]]>><</link>>
				<br>
			<<elseif Time.hour is 3 and $hallucinations gte 2 and $daily.mirrorTentacles isnot 1 and $tentacledisable is "f">>
				<br>
				<span class="purple">An eerie light spills from your mirror.</span>
				<br>
				<<bloodmirroricon>><<link [[Mirror|Eerie Mirror]]>><<set $daily.mirrorTentacles to 1>><<set $phase to 0>><</link>>
				<br>
			<<else>>
				<<homemirroricon>><<link [[Mirror|Lake House Mirror]]>><</link>>
				<br>
			<</if>>
		<<else>>
			You don't have a mirror yet. Bailey won't let you take the one in the orphanage.
			<br>
		<</if>>

		<<if _table>>
			<br>
			Your _table.name <<if _chair>>and a pair of _chair.name are <<else>>is <</if>> situated next to a wall.
			<br>
			<!-- <<if $debug>>
				<<bedroomtablechairicon>><<link [[Table (Debug)|Bedroom Table]]>><</link>>
				<br><br>
			<</if>> -->
		<</if>>

		<<if _bookshelf>>
			<<link [[Read science material (0:20)|$passage]]>><<pass 20>><<scienceskill>><</link>><<gscience>>
			<br>
			<<link [[Read math solutions (0:20)|$passage]]>><<pass 20>><<mathsskill>><</link>><<gmaths>>
			<br>
			<<link [[Read historical journals (0:20)|$passage]]>><<pass 20>><<historyskill>><</link>><<ghistory>>
			<br>
			<<link [[Read old English manuscripts (0:20)|$passage]]>><<pass 20>><<englishskill>><</link>><<genglish>>
			<br>
		<<else>>
			You don't have a bookshelf yet. You will need one to study at home.
			<br>
		<</if>>

		<<if _pc>>
			<<if $lakehouse.billsphase gte 3>>
				You can't use your computer without power.
				<br>
			<<else>>
				<<link [[Play on computer (0:30)|Lake House Play Computer]]>><<pass 30>><<stress -3>><<trauma -3>><</link>><<lstress>><<ltrauma>>
				<br>
				<<link [[Host a cam show dance (0:30)|Lake House Cam Show Dance]]>><<set $dancelocation to "lakehouse">><</link>><<llstress>><<ggtiredness>>
				<br>
			<</if>>
			/* <<link [[Search for job online (0:10)|Lake House Online Search]]>><<pass 10>><</link>>
			<br> */
		<</if>>

		<<if _table or _pc>>
			There's a desk here. You could work on security projects.
			<br>
			<<link [[Sit at the desk|Lake House Upgrades]]>><</link>>
			<br><br>
		<<else>>
			You don't have a table or pc yet. You will need one to manage upgrades.
			<br>
		<</if>>

		<<if $pregnancyStats.parasiteDoctorEvents gte 2>>
			<<if $container.lakehouse is undefined>>
				<<containersInit>>
			<</if>>
			<<fishtankicon>><<containersLink>>
		<</if>>
		
		<<if $lakehouse.terrarium isnot undefined>>
			<<if $lakehouse.terrarium.smallpets isnot undefined>>
				<<set _stress to -1 * ( 1 + $lakehouse.terrarium.smallpets)>>
				<<set _trauma to -1 * ( 1 + $lakehouse.terrarium.smallpets)>>
				<<link [[Observe Terrarium (0:30)|Lake House Observe Terrarium]]>><<pass 30>><<stress _stress>><<trauma _trauma>><</link>><<lstress>><<ltrauma>>
				<br>
			<</if>>
		<</if>>
		<br>
		<br>
		<<main_hall_icon>><<link [[Living Room (0:01)->Lake House]]>><<pass 1>><</link>>
		<br>
		<<link [[Settings]]>><<set $settingsExitPassage to $passage>><</link>>
		<br>
		<<attitudesControlCheck>>
		<<if $attitudesControl.showGoldLink is true>>
			<span class="goldLink"><<link [[Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>> </span><span class="red">!!</span>
		<<else>>
			<<link [[Attitudes]]>><<set $attitudesExitPassage to $passage>><</link>>
		<</if>>
		<br><br>
	<</if>>
<</if>>

:: Lake House Passout
<<pass 1 hour>>
<<set $stress -= 2000>>
<<set $trauma +=10>>
<<passout>>
You've pushed yourself too much.
<br><br>

<<if $location isnot "lakehouse basement">>
	<<link [[Wake up|$previousPassage]]>><</link>>
<<else>>
	<<link [[Wake up|Lake House Basement]]>><</link>>
<</if>>
:: Lake House Bed
<<effects>>
<<wearoutfit>>

You snuggle under the covers.
<<if $wraith.state and $wraithPrison and ($moonstate is "evening" or $moonstate is _nightstate)>>
	You feel anxious, and your eyes dart over to the mirror.
<</if>>
<br><br>

<<lakehouse_sleep_options>>

:: Lake House Sleep
<<set _autosavehere to true>>
<<sleep>><<effects>>
/* <<if $wraith.nightmare is 2 and isBloodmoon() and $lakehouse.barrier is undefined>>
	<<sleepeffects>>
	You dream of a beautiful figure, cloaked in white, standing under the red moon. It has its arms spread out to you in a welcoming gesture. You can feel its gaze boring into your mind as you step closer.
	<br><br>

	It's surrounded by trees, all bending inwards, and floating above a lake. Everything moves around you, and you find yourself hanging above a large ruin. You can't breathe.
	<br><br>

	You slowly open your eyes, and sluggishly stand from the bed. Your ears are ringing.
	<br><br>

	<<wraithPossess "lakehouse">>
	<<storeon "Lake House Bed" "wardrobe">>
	<span class="nextLink"><<link [[Walk.|Lake House Bedroom]]>><<rainWraith>><</link>></span>
	<br>
<<else>> */
	<<wakingEffects $sleepHoursTotal>>
	<<if $nightmares gte 1 and $controlled is 0>>
		You dream you are being hunted by something <<if ["haunt", "despair"].includes($wraith.state) and $rng lte 25>>pale<<else>>dark<</if>> and terrible.
	<<else>>
		<<if $specialClothesEffects.bimboTotal gte random(100,1000) or $arousal gte 9000>>
			Your sleep is plagued by dirty dreams.
			<<arousal `$specialClothesEffects.bimboTotal / 10 * $sleepHoursTotal`>>
			<<arousal `100 * $sleepHoursTotal`>>
			<<if $arousal gte $arousalmax>>
				They push you over the edge.
				<<orgasm>>
			<</if>>
		<<elseif !_wakingEffect>>
			You sleep soundly.
			<br><br>
		<<else>>
			<br><br>
		<</if>>
	<</if>>
	<<sleepeffects>>
	/* <<if $baileywake is 1 and $placeholder is 1>>
		You startle awake hearing commotion outside. <span class="red"><<nnpc_Hes Bailey>> here</span>.
		<br><br>

		<<lakehouse_assault_intro>>
		<br><br>

		<<set _bedroom to "Lake House Bed">>
		<<set $wardrobe_location to "lakehouse">>
		<<wardrobeSelection true>>
		<<storeon _bedroom "check">>
		<<if _store_check is 1>>
			<<storeon _bedroom>>
		<</if>>
		<<link [[Prepare|Lake House Assault Wardrobe]]>><<endevent>><<set $phase to 1>><<unset $baileywake>><</link>>
		<br> */
	<<if $lakehouse.billsphase gte 4>>
		You startle awake hearing commotion outside. <span class="red">They're here to repossess the house</span>.
		<br><br>

		<<radiooutfits>>
		<br><br>

		<<link [[Get up|Lake House Repossession]]>><<bedclotheson "Lake House Bed">><</link>>
		<br>
	<<elseif $lakehouse.billsphase gte 3>>
		You wake up and try to turn on the lights but they don’t seem to work. In fact it seems like nothing electronic in the house works. A paper pinned to your front door says “Since you haven’t paid your bills on time your utilities have been shut off. Pay the bills now or your home will be repossessed.”
		<br><br>

		<<radiooutfits>>
		<br><br>

		<<link [[Get up|Lake House Repossession]]>><<bedclotheson "Lake House Bed">><</link>>
		<br>
	<<else>>
		<<radiooutfits>>
		<br><br>

		<<link [[Get up|Lake House Bedroom]]>><<bedclotheson "Lake House Bed">><</link>>
		<br>
	<</if>>
/* <</if>> */

