			<span class="gold">Core Characteristics</span>
			<br>
			<<link "Set all to 0">>
				<<for _i range _core>>
					<<set V[_i] to 0>><<clamp>>
				<</for>>
				<<replace "#characteristics">><<cheatSection "characteristics">><</replace>>
			<</link>>
			|
			<<link "Set all to max">>
				<<for _i range _core>>
					<<set V[_i] to 50000>><<clamp>>
				<</for>>
				<<replace "#characteristics">><<cheatSection "characteristics">><</replace>>
