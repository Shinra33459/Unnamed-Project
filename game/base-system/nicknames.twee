<<widget "pcpetname">><<silently>>
	<<if _args[0]>>
		<<set $_npc to _args[0]>>
	<<elseif $npc.length gte 1>>
		<<set $_npc to $npc[0]>>
	<</if>>
	<<set $_mod to _args[1]>>
	<<if $wraith.mimic is $_npc>>
		<<set $_wraith to true>>
	<</if>>
	<<set _names to []>>
	<<set _gender to $player.gender_appearance>>

	<<switch $_npc>>
		<<case "Avery" "avery">>
			/* note: female terms for male pc are intentional */
			<<set _names.push(_gender is "m" ? "boy" : "girl")>>
			<<set _love to C.npc.Avery.love>>
			<<set _rage to C.npc.Avery.rage>>
			<<set _dom to C.npc.Avery.dom>>
			<<if _love + _rage gte 25>>
				/* generic */
				<<if _love gte 30>>
					<<set _names.push("doll", "sunshine")>>
					<<if _love gte 60>>
						<<set _names.push("princess")>>
						<<if _gender is "m">><<set _names.push("prince")>><</if>>
					<</if>>
				<</if>>
				<<if _rage gte 30>>
					<<set _names.push("brat")>>
					<<if _rage gte 60>>
						<<set _names.push("cunt")>>
						<<if _gender is "m">><<set _names.push("dick")>><</if>>
					<</if>>
				<</if>>
				/* tf */
				<<if (($cat gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "cat")>>
					<<set _names.push("kitten", "pussy")>>
				<</if>>
				<<if (($wolfgirl gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "wolf")>>
					<<set _names.push("puppy", "pup")>>
				<</if>>
				<<if (($cow gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "cow")>>
					<<set _names.push(_gender is "m"? "cowboy" : "cowgirl")>>
				<</if>>
				<<if (($harpy gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "bird")>>
					<<set _names.push("nestling", "cygnet")>>
				<</if>>
				<<if (($fox gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "fox")>>
					<<set _names.push(_gender is "m" ? "kit" : "vixen")>>
				<</if>>
				<<if (($bear gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "bear")>>
					<<set _names.push("cub")>>
					<<if ["name"].includes(_args[1])>>
						<<set _names.push("honeypaws")>>
					<</if>>
				<</if>>
				<<if (($fox gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "fox")>>
					<<set _names.push("bun")>>
					<<if ["name"].includes(_args[1])>>
						<<set _names.push("cottontail")>>
					<</if>>
				<</if>>
				<<if (($waterdragon gte 7 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "waterdragon")>>
					<<set _names.push("hatchling")>>
					<<if ["name"].includes(_args[1])>>
						<<set _names.push("scales")>>
					<</if>>
				<</if>>
				<<if (($angel gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "angel")>>
					<<set _names.push("angel", "cherub")>>
				<</if>>
				<<if (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
					<<set _names.push("demon", "succubus")>>
					<<if _gender is "m">><<set _names.push("incubus")>><</if>>
				<</if>>
				/* attitude and dominance */
				<<if random(0, 100) lt 40>>
					<<if $submissive gte 1150 or _dom gte 25>>
						<<set _names.push("pet")>>
						<<if $submissive gte 1500 or _dom gte 50>>
							<<set _names.push("toy")>>
							<<if $submissive gte 1900 or _dom gte 75>>
								<<set _names.push("slave")>>
							<</if>>
						<</if>>
					<</if>>
				<</if>>
				/* fame */
				<<if random(0, 100) lt 20>>
					<<if $fame.exhibitionism gte 400>>
						<<set _names.push("show off")>>
						<<if $fame.exhibitionism gte 600>>
							<<set _names.push("flaunty")>>
						<</if>>
					<</if>>
					<<if $fame.sex gte 400>>
						<<set _names.push("nymph")>>
						<<if $fame.sex gte 600>>
							<<set _names.push("slut")>>
						<</if>>
					<</if>>
					<<if $fame.prostitution gte 400>>
						<<set _names.push("tramp")>>
						<<if $fame.prostitution gte 600>>
							<<set _names.push("whore")>>
						<</if>>
					<</if>>
					<<if $fame.rape gte 400>>
						<<set _names.push("fuckdoll")>>
						<<if $fame.rape gte 600>>
							<<set _names.push("fucktoy")>>
						<</if>>
					<</if>>
				<</if>>
				/* mimic */
				<<if $_wraith>>
					<<set _names.push("thief","graverobber")>>
				<</if>>
			<</if>>
			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if _love gte 30 and random(0, 100) lt _love - 30 and !["boy","girl"].includes(_text_output)>>
				<<set _text_output to "little " + _text_output>>
			<</if>>
			<<if _rage gte 50 and random(0, 100) lt _rage - 30>>
				<<set _text_output to "insufferable " + _text_output>>
			<</if>>
			<<if _love gte 60 and random(0, 100) lt _love - 30 and _args[1] isnot "my">>
				<<set _text_output to "my " + _text_output>>
			<</if>>
		<<case "wraith" "Wraith" "Ivory Wraith">>
			<<set _pre to [""]>>
			/* generic */
			<<set _names.push(
				"manifestation",
				"reflection",
				"body"
			)>>
			<<if playerIsPregnant()>>
				<<set _names.push("lifebearer")>>
			<</if>>
			<<if $location is "lake" or $location is "forest">>
				<<set _names.push("trespasser")>>
			<</if>>
			<<if $avery_fate is "ascended">>
				<<set _names.push("betrayer", "footstool")>>
			<</if>>
			/* angry or calm */
			<<if $wraith.state is "haunt" and $_mod isnot "nice" or $_mod is "angry">>
				<<set _names.push(
					"graverobber","graverobber","graverobber","graverobber","graverobber","graverobber",
					"thief","thief","thief","thief",
					"vulture","vulture",
					"forsaker",
					"scion",
					"twig"
				)>>
				<<if playerIsPregnant()>>
					<<set _names.push("seedbed")>>
				<</if>>
				<<set _pre.push(
					"wretched ",
					"baleful ",
					"cruel "
				)>>
			<<else>>
				<<if $wraith.state is "despair">>
					<<set _names.push("accomplice")>>
				<</if>>
				<<set _names.push(
					"promise",
					"droplet",
					"memory",
					"pearl"
				)>>
				<<if $temple_rank isnot undefined and $temple_rank isnot "prospective">>
					<<set _names.push(
						"coalwalker"
					)>>
				<</if>>
				<<if $temple_confessor_intro>>
					<<set _names.push(
						"confessor"
					)>>
				<</if>>
			<</if>>
			/* offspring */
			<<if ["dead","sold"].includes($wraith.offspring)>>
				<<set _names.push(
					"oathbreaker",
					"mutineer",
					"serpent"
				)>>
			<</if>>
			/* tfs, intended to not check for part visibility */
			<<if (($angel gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "angel")>>
				<<set _names.push(
					"messenger",
					"gaoler"
				)>>
				<<set _pre.push("fluttering ")>>
			<</if>>
			<<if $fallenangel gte 2>>
				<<set _names.push(
					"wingless",
					"shard"
				)>>
				<<set _pre.push("fallen ")>>
			<</if>>
			<<if (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
				<<set _names.push(
					"hellion",
					"imp"
				)>>
			<</if>>
			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if random(1,100) lte 15>>
				<<set _text_output to _pre.pluck() + _text_output>>
			<</if>>
		<<case "gwylan" "Gwylan">>
			<<set _yearning to C.npc.Gwylan.dom>>
			<<if ["good", "dear", "bad", "naughty"].includes(_args[1])>>
				<<set _names.push(_gender is "m" ? "boy" : "girl")>>
			<</if>>
			/* tfs, intended to not check for part visibility */
			<<if (($cat gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "cat")>>
				<<set _names.push("kitty")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("paws")>>
					<<if $gwylanSeen?.includes("cream_lick")>>
						<<set _names.push("rough-tongue")>>
					<</if>>
				<</if>>
			<<elseif (($wolfgirl gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "wolf")>>
				<<set _names.push("puppy")>>
				<<if _yearning gte 100>>
					<<set _names.push("dog")>>
					<<if (($angel gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "angel") or ($fallenangel gte 2 or ($transformationParts.fallenAngel.wings isnot "hidden" and $transformationParts.fallenAngel.wings isnot "disabled")) or $dryad gte 6>>
						<<set _names.push("mutt")>>
					<</if>>
					<<if (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
						<<set _names.push("hellpup")>>
					<</if>>
				<</if>>
			<<elseif $harpy gte 6>>
				<<set _names.push("birdie", "canary")>>
				<<if (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
					<<set _names.push("siren")>>
				<</if>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("chirp")>>
				<</if>>
			<<elseif (($fox gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "fox")>>
				<<set _names.push("kit")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("vix")>>
					<<if $gwylanSeen?.includes("gwylan_tf_revealed")>>
						<<set _names.push("kin")>>
					<</if>>
					<<if (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
						<<set _names.push("foxfire")>>
					<</if>>
				<</if>>
			<<elseif $cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")>>
				<<set _names.push("calf")>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("bright eyes")>>
				<</if>>
			<<elseif _yearning gte 35>>
				<<set _names.push("puppy")>>
			<</if>>
			<<if (($angel gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "angel") or $fallenangel gte 2>>
				<<if ["name"].includes(_args[1])>>
					<<set _names.push("angel eyes", "twinkle-top")>>
				<</if>>
			<<elseif (($demon gte 6 and $transformationParts.traits.activeDivineTF is "disabled") or $transformationParts.traits.activeDivineTF is "demon")>>
			<<elseif $dryad gte 6>>
				<<set _names.push("seedling", "sprout")>>
			<</if>>

			/* clothing */
			<<if $worn.upper.name is "pumpkin dress">>
				<<set _names.push("pumpkin")>>
			<</if>>

			/* other */
			<<if (_yearning gte 75 or $hypnosis_traits.devotion gte 4) and ["simple", undefined].includes(_args[1]) or ["my"].includes(_args[1])>>
				<<set _names.push("pet")>>
			<</if>>
			<<if $gwylanSeen?.includes("romance") and ["simple", "name", undefined].includes(_args[1])>>
				<<set _names.push("love", "dearest")>>
			<</if>>
			<<if _names.length is 0 or ["simple", "name", undefined].includes(_args[1])>>
				<<set _names.push("dear")>>
			<</if>>

			/* pick and decorate */
			<<set _text_output to _names.pluck()>>
			<<if !["simple", "bad", "naughty", "good", "dear", "name"].includes(_args[1]) and (_args[1] is "my" or _yearning gte 75 and random(0, 150) lt _yearning - 50 or _text_output.includes("pet"))>>
				<<set $_addMyToStart to true>>
			<</if>>
			<<if !["simple", "name"].includes(_args[1]) and random(0, 150) lt _yearning - 50 and !["boy","girl","dear","love","dearest"].includes(_text_output)>>
				<<set _text_output to "little " + _text_output>>
			<</if>>
			<<if !["simple", "bad", "naughty", "name"].includes(_args[1]) and (["good", "dear"].includes(_args[1]) or _yearning gte 60 and random(0, 150) lt _yearning - 50 and !$gwylan.punishment and $_addMyToStart) and !["dear","love","dearest"].includes(_text_output)>>
				<<if ["good", "dear"].includes(_args[1])>>
					<<if _args[1] is "good">>
						<<set _text_output to "good " + _text_output>>
					<<else>>
						<<set _text_output to "dear " + _text_output>>
					<</if>>
				<<elseif random(0, 1)>>
					<<set _text_output to "good " + _text_output>>
				<<else>>
					<<set _text_output to "dear " + _text_output>>
				<</if>>
			<<elseif !["simple", "good", "dear", "name"].includes(_args[1]) and (["bad", "naughty"].includes(_args[1]) or $gwylan.punishment and $_addMyToStart) and !["dear","love","dearest"].includes(_text_output)>>
				<<if ["bad", "naughty"].includes(_args[1])>>
					<<if _args[1] is "bad">>
						<<set _text_output to "bad " + _text_output>>
					<<else>>
						<<set _text_output to "naughty " + _text_output>>
					<</if>>
				<<elseif random(0, 1)>>
					<<set _text_output to "bad " + _text_output>>
				<<else>>
					<<set _text_output to "naughty " + _text_output>>
				<</if>>
			<</if>>
			<<if $_addMyToStart>>
				<<set _text_output to "my " + _text_output>>
			<</if>>
		<<default>>
			<<girl>>
	<</switch>>
<</silently>><<print _text_output>><</widget>>

<<widget "pcPetname">><<silently>>
	<<pcpetname _args[0] _args[1]>><<capitalise>>
<</silently>><<print _text_output>><</widget>>

<<widget "foxnickname">><<silently>>
	<<if (($fox gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "fox")>>
		<<set _text_output to "kit">>
	<<elseif (($cat gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "cat")>>
		<<set _text_output to "stray">>
	<<elseif (($wolfgirl gte 6 and $transformationParts.traits.activeTF is "disabled") or $transformationParts.traits.activeTF is "wolf")>>
		<<set _text_output to "pup">>
	<<else>>
		<<set _text_output to "meat">>
	<</if>>
<</silently>><<print _text_output>><</widget>>

<<widget "overworld_nickname_dolp">><<silently>>
	<<set $fameTitles = {
		"good": [
			{ "level": 400, "title": "Kind Soul" },
			{ "level": 800, "title": "Compassionate" },
			{ "level": 1600, "title": "Saintly Figure" },
			{ "level": 2400, "title": "Beacon of Hope" },
			{ "level": 3200, "title": "Paragon" },
			{ "level": 4000, "title": "Saintly Icon" }
		],
		"business": [
			{ "level": 400, "title": "Hustler" },
			{ "level": 800, "title": "Entrepreneur" },
			{ "level": 1600, "title": "Deal Maker" },
			{ "level": 2400, "title": "Tycoon" },
			{ "level": 3200, "title": "Kingpin" },
			{ "level": 4000, "title": "The Empire Builder" }
		],
		"social": [
			{ "level": 400, "title": "Social Butterfly" },
			{ "level": 800, "title": "Trendsetter" },
			{ "level": 1600, "title": "Influencer" },
			{ "level": 2400, "title": "High Society" },
			{ "level": 3200, "title": "The Charmer" },
			{ "level": 4000, "title": "The Icon" }
		],
		"model": [
			{ "level": 400, "title": "Pretty Face" },
			{ "level": 800, "title": "Cover Star" },
			{ "level": 1600, "title": "Runway Sensation" },
			{ "level": 2400, "title": "Editorial Icon" },
			{ "level": 3200, "title": "Supermodel Muse" },
			{ "level": 4000, "title": "Photoshoot Legend" }
		],
		"combinations": [
			{ "levels": [400, 400], "categories": ["good", "business"], "title": "Compassionate Capitalist" },
			{ "levels": [400, 400], "categories": ["good", "social"], "title": "Beloved Figure" },
			{ "levels": [400, 400], "categories": ["good", "model"], "title": "Graceful Icon" },
			{ "levels": [400, 400], "categories": ["business", "social"], "title": "Networking Guru" },
			{ "levels": [400, 400], "categories": ["business", "model"], "title": "Corporate Star" },
			{ "levels": [400, 400], "categories": ["social", "model"], "title": "Photogenic Charmer" },

			{ "levels": [1600, 1600], "categories": ["good", "business"], "title": "Altruistic Mogul" },
			{ "levels": [1600, 1600], "categories": ["good", "social"], "title": "Saint of the People" },
			{ "levels": [1600, 1600], "categories": ["good", "model"], "title": "Elegance Embodied" },
			{ "levels": [1600, 1600], "categories": ["business", "social"], "title": "Social Mogul" },
			{ "levels": [1600, 1600], "categories": ["business", "model"], "title": "Marketable Beauty" },
			{ "levels": [1600, 1600], "categories": ["social", "model"], "title": "Celebrity" },

			{ "levels": [3200, 3200], "categories": ["good", "business"], "title": "Philanthropist Tycoon" },
			{ "levels": [3200, 3200], "categories": ["good", "social"], "title": "Guiding Light" },
			{ "levels": [3200, 3200], "categories": ["good", "model"], "title": "Divine Beauty" },
			{ "levels": [3200, 3200], "categories": ["business", "social"], "title": "Power Broker" },
			{ "levels": [3200, 3200], "categories": ["business", "model"], "title": "Media Mogul" },
			{ "levels": [3200, 3200], "categories": ["social", "model"], "title": "Fashion Royalty" },

			{ "levels": [4000, 4000, 4000, 4000], "categories": ["good", "business", "social", "model"], "title": "The One and Only" }
		]
	} >>
	<<set _fame_types = ["good", "business", "social", "model"]>>
	<<set _text_output = "Some Orphan">>  <!-- Default title -->
	<<set _highest_fame = {}>>  <!-- Track highest title per fame type -->

	<!-- Get highest fame titles -->
	<<for _type range _fame_types>>
		<<set _fame_value = $fame[_type]>>
		<<for _entry range $fameTitles[_type]>>
			<<if _fame_value >= _entry.level>>
				<<set _highest_fame[_type] to _entry.title>>
			<</if>>
		<</for>>
	<</for>>

	<!-- Check for best combination -->
	<<for _combo range $fameTitles.combinations>>
		<<set _match_count = 0>>
		<<for _category range _combo.categories>>
			<<if _highest_fame[_category] is not undefined>>
				<<set _match_count += 1>>
			<</if>>
		<</for>>
		
		<!-- If all required categories match, use this combo title -->
		<<if _match_count == _combo.categories.length>>
			<<set _text_output = _combo.title>>
		<</if>>
	<</for>>

	<!-- If no combination title matched, use the highest individual one -->
	<<if _text_output is "Some Orphan" and _highest_fame[Object.keys(_highest_fame)[0]] isnot undefined>>
		<<set _text_output = _highest_fame[Object.keys(_highest_fame)[0]]>>
	<</if>>

<</silently>><<print _text_output>><</widget>>