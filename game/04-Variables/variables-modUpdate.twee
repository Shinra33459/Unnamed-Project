	<</if>>

	<<set setup.loveAlias to {
		"Avery": () => "Love",
		"Bailey": () => "Respect",
		"Briar": () => "Respect",
		"Charlie": () => "Respect",
		"Darryl": () => "Affection",
		"Doren": () => "Affection",
		"Eden": () => "Love",
		"Gwylan": () => V.gwylanSeen?.includes("partners") ? "Love" : "Interest",
		"Harper": () => "Interest",
		"Jordan": () => "Respect",
		"Kylar": () => "Love",
		"Landry": () => "Interest",
		"Leighton": () => "Interest",
		"Mason": () => "Affection",
		"Morgan": () => "Affection",
		"River": () => "Respect",
		"Robin": () => "Love",
		"Sam": () => "Respect",
		"Sirris": () => "Affection",
		"Whitney": () => "Love",
		"Winter": () => "Affection",
		"Black Wolf": () => "Love",
		"Niki": () => "Respect",
		"Quinn": () => "Interest",
		"Remy": () => "Interest",
		"Alex": () => "Love",
		"Great Hawk": () => "Love",
		"Wren": () => "Affection",
		"Sydney": () => "Love",
		"Ivory Wraith": () => "Love",
		"Zephyr": () => "Interest",
		"Riley": () => "Respect",
		"Night Monster": () => "Love",
		"Poppy": () => "Love",

		/* Persistent NPC */
		"anxious_guard": () => "Respect",
		"hacker": () => "Respect",
		"manager": () => "Affection",
		"methodical_guard": () => "Respect",
		"relaxed_guard": () => "Respect",
		"scarred_inmate": () => "Affection",
		"tattoed_inmate": () => "Interest",
		"veteran_guard": () => "Respect"
	}>>

	<<modLI-init>>

	/* Poppy LI data migration. Use the save's NPC index rather than the static alias index. */
	<<if $objectVersion.poppyLIData is undefined or $objectVersion.poppyLIData lt 2>>
		<<if $daily is undefined or $daily is null or typeof $daily isnot "object" or Array.isArray($daily)>>
			<<set $daily to {}>>
		<</if>>
		<<if $daily.poppy is undefined or $daily.poppy is null or typeof $daily.poppy isnot "object" or Array.isArray($daily.poppy)>>
			<<set $daily.poppy to {}>>
		<</if>>

		<<if !Array.isArray($poppySeen)>>
			<<if $poppySeen isnot undefined>>
				<<set $poppySeen_legacy to $poppySeen>>
			<</if>>
			<<set $poppySeen to []>>
		<</if>>

		<<set _poppyIndex to (Array.isArray($NPCNameList) ? $NPCNameList.indexOf("Poppy") : -1)>>
		<<if _poppyIndex gte 0 and $NPCName[_poppyIndex]>>
			<<set _poppy to $NPCName[_poppyIndex]>>
			<<if _poppy.timer is undefined or _poppy.timer is null or typeof _poppy.timer isnot "object" or Array.isArray(_poppy.timer)>><<set _poppy.timer to {}>><</if>>
			<<if _poppy.timer.lastInteraction is undefined or _poppy.timer.lastInteraction is "">><<set _poppy.timer.lastInteraction to Time.date.timeStamp>><</if>>
			<<if _poppy.timer.lastPatienceDecay is undefined or _poppy.timer.lastPatienceDecay is "">><<set _poppy.timer.lastPatienceDecay to Time.date.timeStamp>><</if>>
			<<if typeof _poppy.patience isnot "number" or Number.isNaN(_poppy.patience)>><<set _poppy.patience to 100>><</if>>
			<<if _poppy.pregnancy is undefined or _poppy.pregnancy is null or typeof _poppy.pregnancy isnot "object" or Array.isArray(_poppy.pregnancy)>>
				<<set _poppy.pregnancy to { fetus: [], enabled: true, type: null }>>
			<<else>>
				<<if !Array.isArray(_poppy.pregnancy.fetus)>><<set _poppy.pregnancy.fetus to []>><</if>>
				<<if typeof _poppy.pregnancy.enabled isnot "boolean">><<set _poppy.pregnancy.enabled to true>><</if>>
				<<if _poppy.pregnancy.type is "none" or _poppy.pregnancy.type is undefined>><<set _poppy.pregnancy.type to null>>

				<<elseif _poppy.pregnancy.type and !_poppy.pregnancy.fetus.length and !_poppy.pregnancy.timerEnd>><<set _poppy.pregnancy.type to null>><</if>>
			<</if>>
			<<set $objectVersion.poppyPregnancy to 1>>
			<<set $objectVersion.poppyLIData to 2>>
		<</if>>
	<</if>>

	<<set $robinmoney to Math.round($robinmoney)>>

	<<set _remove to ["Salem", "Casey", "Tracey", "Taylor"]>>

	<<for _i to 0; _i lt $NPCName.length; _i++>>
		<<if _remove.includes($NPCName[_i].nam)>>
			<<run $NPCName.splice(_i, 1)>>
			<<set _i -= 1>>
		<</if>>
	<</for>>

	<<if $gwylan isnot undefined && $gwylan.request isnot undefined && $gwylan.request.items isnot undefined>>
		<<for _i to 0; _i lt $gwylan.request.items.length; _i++>>
			<<if ["ghost_orchid", "hen_of_the_woods", "red_helleborine", "lady_orchid", "fly_agaric", "spiked_rampion", "cloudberry", "scottish_bog_myrtle", "bog_orchid", "marsh_saxifrage"].includes($gwylan.request.items[_i].name)>>
				<<set $gwylan.request.items[_i].name to "mushroom">>
				<<set $gwylan.request.items[_i].type to "shroom">>
			<</if>>
		<</for>>
	<</if>>

	<<if C.npc is undefined or C.npc.Poppy is undefined>>
		/* stop here; Poppy base object must exist first */
	<<else>>
		<<set _poppyIndex to $NPCNameList.indexOf("Poppy")>>
		<<if _poppyIndex is -1>>
			/* Poppy missing entirely: append both list + object */
			<<run $NPCNameList.push("Poppy")>>
			<<run $NPCName.push(C.npc.Poppy)>>
		<<else>>
			/* Poppy name exists, but object slot may be missing/wrong */
			<<if $NPCName[_poppyIndex] is undefined or $NPCName[_poppyIndex].nam isnot "Poppy">>
				<<set $NPCName[_poppyIndex] to C.npc.Poppy>>
			<</if>>
		<</if>>
	<</if>>

	<<set $opium_addiction to $opium_addiction ?? 0>>
	<<set $opium_timer to $opium_timer ?? 0>>
	<<set $opium_knowledge to $opium_knowledge ?? 0>>
	<<set $opium_message to $opium_message ?? "">>

	<<if $player.virginity.penile is "Frostberg">>
		<<set $player.virginity.penile to "unknown">>
	<</if>>

