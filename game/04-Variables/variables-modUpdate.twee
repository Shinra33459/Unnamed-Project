		<<set $options.autoNNPCDisplay to {
			enabled: true
		}>>
		<<for _name range setup.NPCNameList>>
			<<if _name == "Black Wolf">>
				<<set _name = "black_wolf">>
			<<elseif _name == "Great Hawk">>
				<<set _name = "great_hawk">>
			<<elseif _name == "Ivory Wraith">>
				<<set _name = "ivory_wraith">>
			<<elseif _name == "Night Monster">>
				<<set _name = "night_monster">>
			<</if>>
			<<set $options.autoNNPCDisplay[_name.toLowerCase()] to {
				slot: 1,
				layer: "front"
			}>>
		<</for>>
	<</if>>

	<<if $options.autoNNPCDisplay.robin.genderOverride is undefined>>
		<<for _name range setup.NPCNameList>>
			<<set _nameReal to _name>>
			<<if _name == "Black Wolf">>
				<<set _name = "black_wolf">>
			<<elseif _name == "Great Hawk">>
				<<set _name = "great_hawk">>
			<<elseif _name == "Ivory Wraith">>
				<<set _name = "ivory_wraith">>
			<<elseif _name == "Night Monster">>
				<<set _name = "night_monster">>
			<</if>>
			<<if $options.autoNNPCDisplay[_name.toLowerCase()].genderOverride is undefined>>
				<<set $options.autoNNPCDisplay[_name.toLowerCase()].genderOverride to false>>
				<<if C.npc[_nameReal].pronoun is "m">>
					<<set $options.autoNNPCDisplay[_name.toLowerCase()].gender to "male">>
				<<else>>
					<<set $options.autoNNPCDisplay[_name.toLowerCase()].gender to "female">>
				<</if>>
			<</if>>
		<</for>>
	<</if>>

	<<if $options.autoNNPCDisplay.others is undefined>>
		<<set $options.autoNNPCDisplay.others to {
			genderOverride: false,
			gender: ""
		}>>
	<</if>>

	<<if $options.nnpcDisplayGender is undefined>>
		<<set $options.nnpcDisplayGender to "male">>
	<</if>>

	<<if $options.autoNNPCDisplay.morgan.gender is "">>
		<<for _name range setup.NPCNameList>>
			<<set _nameReal to _name>>
			<<if _name == "Black Wolf">>
				<<set _name = "black_wolf">>
			<<elseif _name == "Great Hawk">>
				<<set _name = "great_hawk">>
			<<elseif _name == "Ivory Wraith">>
				<<set _name = "ivory_wraith">>
			<<elseif _name == "Night Monster">>
				<<set _name = "night_monster">>
			<</if>>
