				<<if C.npc[_nameReal].pronoun is "m">>
					<<set $options.autoNNPCDisplay[_name.toLowerCase()].gender to "male">>
				<<else>>
					<<set $options.autoNNPCDisplay[_name.toLowerCase()].gender to "female">>
				<</if>>
			<</if>>
