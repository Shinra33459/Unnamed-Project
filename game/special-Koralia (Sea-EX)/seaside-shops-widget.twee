<<widget "seasideshop">>
    <<silently>>
    <<set _ssshopname to []>>
    <<set _ssshopname.push("the seaside shop","the small shop along the shore")>>
    <<if $koraliaStatus.includes("met") and !$koraliaStatus.includes("sealed")>>
        <<set _ssshopname.push("Koralia's Shop")>>
    <<elseif $koraliaStatus.includes("sealed")>>
        <<set _ssshopname.push("Koralia's Old Shop")>>
    <</if>>
    <</silently>><<print _ssshopname>>
<</widget>>