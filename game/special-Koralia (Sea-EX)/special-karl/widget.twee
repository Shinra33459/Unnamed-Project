:: Seaside Stall Widget
<<widget "karl">>

<</widget>>
<<widget "karlaction">>
<!-- seasonal, and random as heck-->
<</widget>>
<<widget "boxedduck">>
<!-- ...I just wanna make shitty widget -->
    <<if $duckcollection.count is 0>>

    <<elseif $duckcollection.count lt $duckcollection.maxCount / 3>>

    <<elseif $duckcollection.count lt $duckcollection.maxCount / 2>>
        Boxes piles behind the stall.
    <<elseif $duckcollection.count lt $duckcollection.maxCount / 1.5>>
        The stall is relatively tidy.
    <<elseif $duckcollection.count lt $duckcollection.maxCount / 1.25>>
        The stall is reasonably neat.
    <<else>>
        The stall is tidy.
    <</if>>
    <<if $duckavailable is 1>>
        <span class="green">You noticed a new box among the clutter.</span>
    <</if>>
<</widget>>
