
:: Events Subway [widget]

<<widget "subwaytrip">>
	<<if $worn.feet.type.includes("naked")>>
		Your bare foot steps on a hard and jagged rock. It doesn't hurt much, but the shock makes you lose your footing and you tumble into a fern.
		<<gstress>><<gpain>><<stress 6>><<pain 6>>
		<br><br>

		<<destinationsubway>>
		<br>
	<<else>>
		The ground here is covered by hard and jagged rocks. They're hard to spot within the grass, but your $worn.feet.name hold up.
		<br><br>

		<<destinationsubway>>
		<br>
	<</if>>
<</widget>>

<<widget "subwayparanoia">>
	Something brushes against your ankle. You look down, but see nothing.<<stress 8>><<gstress>>
		<br><br>

		<<destinationsubway>>
<</widget>>

<<widget "subwayfloodedtunnel">>
	You come to a fast-flowing river.
	<<if $foresthunt gte 1>>
		You might be able to use it to disrupt your trail and escape your pursuer, but it looks dangerous.
	<</if>>
	<br><br>

	<<link [[Swim across|Subway Swim]]>><<set $subway_darkness to 0>><</link>><<swimmingdifficulty 1 600>>
	<br>
	<<destinationsubway>>
	<br>
<</widget>>

<<widget "subwayticket">>
	You spot an old ticket lying on the ground. Due to it's age and good condition it might belong in a museum.
	<br><br>

	<<set $antiquemoney += 20>>

	/*<<set $antiquemoney += 20>><<museumAntiqueStatus "antiquesubwayticket" "found">>*/
	<<destinationsubway>>
	<br>
<</widget>>


:: Subway Swim

<<location "underground">><<water>><<effects>>
	<<swimmingdifficulty 1 600 true>>
	<<if $swimmingSuccess>>
		The rushing water tears at you.
		<<set $stripintegrity to 20>><<set $stripobject to "jutting rock">><<stripobject>>
		Despite this, you <span class="green">successfully</span> swim through.
		<br><br>
		<<destinationsubway>>
	<<else>>
		The rushing water tears at you.
		<<set $stripintegrity to 100>><<set $stripobject to "jutting rock">><<stripobject>>
		The water is too violent, and you <span class="red">fail</span> to swim through the tunnel, you end up back where you started.
		<br><br>
		<<destinationsubway>>
		<br>
	<</if>>
<<set $eventskip to 0>>
