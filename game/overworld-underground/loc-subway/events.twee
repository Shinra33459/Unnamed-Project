
:: Events Subway [widget]

<<widget "subwayvampireassault">>
	<<npc Lennox>><<person1>>
	In the darkness you stumble around, unaware of your surroundings. Suddenly you see a flash of red and someone grabs you from behind.
	<br><br>

	<<link [[Next|Subway Vampire Assault]]>><<set $fightstart to 1>><</link>>
<</widget>>

<<widget "subwaytrip">>
	<<if $worn.feet.type.includes("naked")>>
		Your bare foot steps on the rails. It doesn't hurt much, but the shock makes you lose your footing and you slip and fall.
		<<gstress>><<gpain>><<stress 6>><<pain 6>>
		<br><br>

		<<set $subway_darkness -= 20>>
		<<destinationsubway>>
		<br>
	<<else>>
		The rails here are damp and slippery. Thankfully your $worn.feet.name are enough to prevent you slipping on them.
		<br><br>

		<<set $subway_darkness -= 30>>
		<<destinationsubway>>
		<br>
	<</if>>
<</widget>>

<<widget "subwayparanoia">>
	Something brushes against your ankle. You look down, but see nothing.<<stress 8>><<gstress>>
		<br><br>
		<<set $subway_darkness += 5>>
		<<destinationsubway>>
<</widget>>

<<widget "subwayfloodedtunnel">>
	You come to a fork in the road. One of the branching tunnels ahead is flooded.
	<<if $$subway_darkness gte 50>>
		You might be able to use it to disrupt your trail and escape your pursuer, but it looks dangerous.
	<</if>>
	<br><br>

	<<link [[Swim through|Subway Swim]]>><<set $subway_darkness to 0>><</link>><<swimmingdifficulty 1 600>>
	<br>
	<<destinationsubway>>
	<br>
<</widget>>

<<widget "subwayticket">>
	You spot an old ticket lying on the ground. Due to it's age and good condition it might belong in a museum.
	<br><br>

	<<set $antiquemoney += 20>>

	/*<<set $antiquemoney += 20>><<museumAntiqueStatus "antiquesubwayticket" "found">>*/
	<<set $subway_darkness -= 20>>
	<<destinationsubway>>
	<br>
<</widget>>


:: Subway Swim

<<location "underground">><<water>><<effects>>
	<<swimmingdifficulty 1 600 true>>
	<<if $swimmingSuccess>>
		The rushing water tears at you.
		<<set $stripintegrity to 20>><<set $stripobject to "jutting rock">><<stripobject>>
		Despite this, you <span class="green">successfully</span> swim through.
		<br><br>
		<<set $subway_darkness -= 100>>
		<<destinationsubway>>
	<<else>>
		The rushing water tears at you.
		<<set $stripintegrity to 100>><<set $stripobject to "jutting rock">><<stripobject>>
		The water is too violent, and you <span class="red">fail</span> to swim through the tunnel, you end up back where you started.
		<br><br>
		<<destinationsubway>>
		<br>
	<</if>>
<<set $eventskip to 0>>

:: Subway Vampire Assault
<<if $fightstart is 1>>
	<<set $fightstart to 0>>

	<<neutral 1>>

	<<maninit>>
	<<set $enemytrust -= 100>>
	<<set $enemyanger += 200>>
	<<npcidlegenitals>>
	<<set $enemyhealthmax += 250>><<set $enemyhealth += 250>>
<</if>>

<<effects>>
<<effectsman>>

<<man>>
<<stateman>>
<br><br>
<<actionsman>>

<<if _combatend or ($pain gte 100 and $willpowerpain is 0)>>
	<span id="next"><<link [[Next|Subway Vampire Assault Finish]]>><</link>></span><<nexttext>>
<<else>>
	<span id="next"><<link [[Next|Subway Vampire Assault]]>><</link>></span><<nexttext>>
<</if>>

:: Subway Vampire Assault Finish
<<effects>>
<<if $enemyarousal gte $enemyarousalmax>>
	<<ejaculation>>

	<<tearful>> you escape into another tunnel.
	<br><br>

	<<clotheson>>
	<<endcombat>>
	
	<<subwaylinks>>

<<elseif $enemyhealth lte 0>>
	You shove the figure away from you, dodge <<his>> clutching grasp and stumble to your feet.
	<br><br>

	<<tearful>> you escape into another tunnel.
	<br><br>

	<<clotheson>>
	<<endcombat>>

	<<subwaylinks>>

<<else>>

	<<clotheson>>
	<<endcombat>>

	<<subwaylinks>>
<</if>>
