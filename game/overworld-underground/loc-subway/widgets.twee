:: Widgets Subway [widget]

<<widget "subway_darkness">>
	<<set $subway_darkness += 10>>
	<<if $subway_darkness == 0>>
		<span class="green">The subway is lit by an array of maintenance lights.</span>
	<<elseif $subway_darkness gte 20>>
		<span class="teal">You see a light flicker and die.</span>
	<<elseif $subway_darkness gte 40>>
		<<gstress>><<trauma 1>><<stress 2>>
		<span class="lblue">More lights are flickering off every minute.</span>
	<<elseif $subway_darkness gte 60>>
		<<gstress>><<trauma 1>><<stress 6>>
		<span class="blue">Many of the lights have gone out, the tunnels are becoming darker.</span>
	<<elseif $subway_darkness gte 80>>
		<<gstress>><<trauma 1>><<stress 8>>
		<span class="purple">You are in near complete darkness, with only a few lights remaining.</span>
	<<elseif $subway_darkness gte 100>>
		<<gstress>><<trauma 1>><<stress 10>>
		<span class="red">You are in complete darkness, you think you saw something red and glowing.</span>
	<</if>>
<</widget>>
