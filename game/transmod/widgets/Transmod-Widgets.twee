:: Transmod Update Widget [widget]

<<widget "modUpdate">>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["body growth"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["body reduction"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $sexStats.pills.pills && $sexStats.pills.pills["body blocker"] is undefined>>
		<<physicalAdjustmentsInit>>
	<</if>>
	<<if $player.bodytype is undefined>>
		<<set $player.bodytype to 0>>
	<</if>>
	<<if $bodygrowthtimer is undefined>>
		<<set $bodygrowthtimer to 350>>
	<</if>>
	<<if $player.trans is undefined>>
		<<set $player.trans to "f">>
	<</if>>
	<<if $player.surgery is undefined>>
		<<set $player.surgery to "f">>
	<</if>>
	<<if $surgeryToggle is undefined>>
		<<set $surgeryToggle to "f">>
	<</if>>
	<<if $slurToggle is undefined>>
		<<set $slurToggle to "f">>
	<</if>>
	<<if $staticBody is undefined>>
		<<set $staticBody to 0>>
	<</if>>
	<<if $capBody is undefined>>
		<<set $capBody to 0>>
	<</if>>
	<<if $clubCheck is undefined>>
		<<set $clubCheck to "f">>
	<</if>>
	<<if $markAcquired is undefined>>
		<<set $markAcquired to "f">>
	<</if>>
	<<if (!$player.penisExist and setup.bodyliquid.bodyparts.includes("penis") ) or (!$player.vaginaExist and setup.bodyliquid.bodyparts.includes("vagina", "vaginaoutside"))>>
		<<if !$player.penisExist>>
			<<set $player.penisExist to true>>
			<<bodyliquid "penis" "semen" -5>>
			<<bodyliquid "penis" "slime" -5>>
			<<bodyliquid "penis" "nectar" -5>>
			<<set $player.penisExist to false>>
		<<elseif !$player.vaginaExist>>
			<<set $player.vaginaExist to $true>>
			<<bodyliquid "vaginaoutside" "semen" -5>>
			<<bodyliquid "vaginaoutside" "slime" -5>>
			<<bodyliquid "vaginaoutside" "nectar" -5>>
			<<bodyliquid "vagina" "semen" -5>>
			<<bodyliquid "vagina" "slime" -5>>
			<<bodyliquid "vagina" "nectar" -5>>
			<<set $player.vaginaExist to false>>
		<</if>>
	<</if>>
	/*
			<<if Time.days gte 50>>
				<<if $player.trans is "t">>
					<<if $player.gender is "m">>
						<<earnFeat "Being a Trans Girl">>
					<<elseif $player.gender is "f">>
						<<earnFeat "Being a Trans Boy">>
					<</if>>
				<</if>>
			<</if>>*/
<</widget>>

